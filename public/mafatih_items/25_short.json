  "verses": [
    {
      "index": 1,
      "arabic": "اَللّٰهُمَّ اجْعَلْنِيْ فِيْهِ مُحِبًّا لِاَوْلِيَآئِكَ،",
      "translation": "O Allah, on this day, (please) make me bear love for Your intimate servants,"
    },
    {
      "index": 2,
      "arabic": "وَمُعَادِيًا لِاَعْدَآئِكَ،",
      "translation": "bear enmity towards Your enemies,"
    },
    {
      "index": 3,
      "arabic": "مُسْتَنًّا بِسُنَّةِ خَاتَمِ اَنْبِيَآئِكَ،",
      "translation": "and follow the instructions of the seal of Your Prophets."
    },
    {
      "index": 4,
      "arabic": "يَا عَاصِمَ قُلُوْبِ النَّبِيِّيْنَ۔",
      "translation": "O Protector of the Prophet’s hearts!"
    }
  ],
