  "verses": [
    {
      "index": 1,
      "arabic": "اَللّٰهُمَّ ارْزُقْنِيْ فِيْهِ رَحْمَةَ الْاَيْتَامِ،",
      "translation": "O Allah, on this day, (please) grant me having mercy upon the orphans,"
    },
    {
      "index": 2,
      "arabic": "وَاِطْعَامَ الطَّعَامِ،",
      "translation": "serving food,"
    },
    {
      "index": 3,
      "arabic": "وَاِفْشَاۤءَ السَّلَامِ،",
      "translation": "greeting the people,"
    },
    {
      "index": 4,
      "arabic": "وَصُحْبَةَ الْكِرَامِ،",
      "translation": "and accompanying the noble ones,"
    },
    {
      "index": 5,
      "arabic": "بِطَوْلِكَ يَا مَلْجَاَ الْاٰمِلِيْنَ۔",
      "translation": "in the name of Your favoring, O Shelter of the hopeful ones!"
    }
  ],
