  "introduction": "FIFTH COMPREHENSIVE FORM OF ZIYARAH\n\nThis comprehensive form begins with the following statement:\n\nThis form has been previously cited within the rites in Rajab.\n\nThe total of the comprehensive forms of ziyarah has been five in number. These forms will be sufficient, Allah willing.",
  "versesCount": 48,
  "verses": [
    {
      "index": 1,
      "arabic": "اَلْحَمْدُ لِلّٰهِ الَّذِيْ اَشْهَدَنَا مَشْهَدَ اَوْلِيَاۤئِهِ فِي رَجَبٍ",
      "translation": ""
    },
    {
      "index": 2,
      "arabic": "وَ اَوْجَبَ عَلَيْنَا مِنْ حَقِّهِمْ مَا قَدْ وَجَبَ",
      "translation": ""
    },
    {
      "index": 3,
      "arabic": "وَ صَلَّى اللّٰهُ عَلٰى مُحَمَّدٍ الْمُنْتَجَبِ",
      "translation": ""
    },
    {
      "index": 4,
      "arabic": "وَ عَلٰى اَوْصِيَاۤئِهِ الْحُجُبِ",
      "translation": ""
    },
    {
      "index": 5,
      "arabic": "اَللّٰهُمَّ فَكَمَا اَشْهَدْتَنَا مَشْهَدَهُمْ",
      "translation": ""
    },
    {
      "index": 6,
      "arabic": "فَاَنْجِزْ لَنَا مَوْعِدَهُمْ",
      "translation": ""
    },
    {
      "index": 7,
      "arabic": "وَ اَوْرِدْنَا مَوْرِدَهُمْ",
      "translation": ""
    },
    {
      "index": 8,
      "arabic": "غَيْرَ مُحَلَّئِيْنَ عَنْ وِرْدٍ",
      "translation": ""
    },
    {
      "index": 9,
      "arabic": "فِي دَارِ الْمُقَامَةِ وَ الْخُلْدِ",
      "translation": ""
    },
    {
      "index": 10,
      "arabic": "وَ السَّلَامُ عَلَيْكُمْ",
      "translation": ""
    },
    {
      "index": 11,
      "arabic": "اِنِّي [قَدْ] قَصَدْتُكُمْ وَ اعْتَمَدْتُكُمْ",
      "translation": ""
    },
    {
      "index": 12,
      "arabic": "بِمَسْاَلَتِيْ وَ حَاجَتِيْ",
      "translation": ""
    },
    {
      "index": 13,
      "arabic": "وَ هِيَ فَكَاكُ رَقَبَتِي مِنَ النَّارِ",
      "translation": ""
    },
    {
      "index": 14,
      "arabic": "وَ الْمَقَرُّ مَعَكُمْ فِي دَارِ الْقَرَارِ",
      "translation": ""
    },
    {
      "index": 15,
      "arabic": "مَعَ شِيْعَتِكُمُ الْاَبْرَارِ",
      "translation": ""
    },
    {
      "index": 16,
      "arabic": "وَ السَّلَامُ عَلَيْكُمْ بِمَا صَبَرْتُمْ",
      "translation": ""
    },
    {
      "index": 17,
      "arabic": "فَنِعْمَ عُقْبَى الدَّارِ",
      "translation": ""
    },
    {
      "index": 18,
      "arabic": "اَنَا سَاۤئِلُكُمْ وَ آمِلُكُمْ فِيْمَا اِلَيْكُمُ التَّفْوِيْضُ",
      "translation": ""
    },
    {
      "index": 19,
      "arabic": "وَ عَلَيْكُمُ التَّعْوِيْضُ",
      "translation": ""
    },
    {
      "index": 20,
      "arabic": "فَبِكُمْ يُجْبَرُ الْمَهِيْضُ",
      "translation": ""
    },
    {
      "index": 21,
      "arabic": "وَ يُشْفَى الْمَرِيْضُ،",
      "translation": ""
    },
    {
      "index": 22,
      "arabic": "وَ مَا تَزْدَادُ الْاَرْحَامُ وَ مَا تَغِيْضُ",
      "translation": ""
    },
    {
      "index": 23,
      "arabic": "اِنِّي بِسِرِّكُمْ مُؤْمِنٌ",
      "translation": ""
    },
    {
      "index": 24,
      "arabic": "وَ لِقَوْلِكُمْ مُسَلِّمٌ",
      "translation": ""
    },
    {
      "index": 25,
      "arabic": "وَ عَلَى اللّٰهِ بِكُمْ مُقْسِمٌ",
      "translation": ""
    },
    {
      "index": 26,
      "arabic": "فِي رَجْعِيْ بِحَوَاۤئِجِيْ",
      "translation": ""
    },
    {
      "index": 27,
      "arabic": "وَ قَضَاۤئِهَا وَ اِمْضَاۤئِهَا",
      "translation": ""
    },
    {
      "index": 28,
      "arabic": "وَ اِنْجَاحِهَا وَ اِبْرَاحِهَا",
      "translation": ""
    },
    {
      "index": 29,
      "arabic": "وَ بِشُئُوْنِي لَدَيْكُمْ وَ صَلَاحِهَا",
      "translation": ""
    },
    {
      "index": 30,
      "arabic": "وَ السَّلَامُ عَلَيْكُمْ سَلَامَ مُوَدِّعٍ",
      "translation": ""
    },
    {
      "index": 31,
      "arabic": "وَ لَكُمْ حَوَاۤئِجَهُ مُوْدِعٍ",
      "translation": ""
    },
    {
      "index": 32,
      "arabic": "يَسْاَلُ اللّٰهَ اِلَيْكُمُ الْمَرْجِعَ",
      "translation": ""
    },
    {
      "index": 33,
      "arabic": "وَ سَعْيَهُ اِلَيْكُمْ غَيْرَ مُنْقَطِعٍ",
      "translation": ""
    },
    {
      "index": 34,
      "arabic": "وَ اَنْ يَرْجِعَنِيْ مِنْ حَضْرَتِكُمْ خَيْرَ مَرْجِعٍ",
      "translation": ""
    },
    {
      "index": 35,
      "arabic": "اِلٰى جَنَابٍ مُمْرِعٍ",
      "translation": ""
    },
    {
      "index": 36,
      "arabic": "وَ خَفْضِ عَيْشٍ مُوَسَّعٍ",
      "translation": ""
    },
    {
      "index": 37,
      "arabic": "وَ دَعَةٍ وَ مَهَلٍ اِلٰى حِيْنِ الْاَجَلِ",
      "translation": ""
    },
    {
      "index": 38,
      "arabic": "وَ خَيْرِ مَصِيْرٍ وَ مَحَلٍّ فِي النَّعِيْمِ الْاَزَلِ",
      "translation": ""
    },
    {
      "index": 39,
      "arabic": "وَ الْعَيْشِ الْمُقْتَبَلِ",
      "translation": ""
    },
    {
      "index": 40,
      "arabic": "وَ دَوَامِ الْأُكُلِ",
      "translation": ""
    },
    {
      "index": 41,
      "arabic": "وَ شُرْبِ الرَّحِيْقِ وَ السَّلْسَلِ",
      "translation": ""
    },
    {
      "index": 42,
      "arabic": "وَ عَلٍّ وَ نَهَلٍ لَا سَاَمَ مِنْهُ وَ لَا مَلَلَ",
      "translation": ""
    },
    {
      "index": 43,
      "arabic": "وَ رَحْمَةُ اللّٰهِ وَ بَرَكَاتُهُ وَ تَحِيَّاتُهُ عَلَيْكُمْ",
      "translation": ""
    },
    {
      "index": 44,
      "arabic": "حَتَّى الْعَوْدِ اِلٰى حَضْرَتِكُمْ",
      "translation": ""
    },
    {
      "index": 45,
      "arabic": "وَ الْفَوْزِ فِي كَرَّتِكُمْ",
      "translation": ""
    },
    {
      "index": 46,
      "arabic": "وَ الْحَشْرِ فِي زُمْرَتِكُمْ",
      "translation": ""
    },
    {
      "index": 47,
      "arabic": "وَ رَحْمَةُ اللّٰهِ وَ بَرَكَاتُهُ عَلَيْكُمْ وَ صَلَوَاتُهُ وَ تَحِيَّاتُهُ",
      "translation": ""
    },
    {
      "index": 48,
      "arabic": "وَ هُوَ حَسْبُنَا وَ نِعْمَ الْوَكِيْلُ۔",
      "translation": ""
    }
  ],
