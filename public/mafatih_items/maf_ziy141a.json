  "audioUrl": null,
  "introduction": "ZIYARAH OF ‘ABD AL-’AZIM\n\nScholars have not mentioned a form of ziyarah dedicated to ‘Abd al-’Azim al-Hasani; rather, Fakhr al-Muhaqqiqin (the pride of versed scholars), Jamal al-Din states in his book of al-Mazar that it is most appropriate to say the following form of ziyarah at the tomb of ‘Abd al-’Azim al-Hasani:",
  "versesCount": 80,
  "verses": [
    {
      "index": 1,
      "arabic": "اَلسَّلَامُ عَلٰى اٰدَمَ صِفْوَةِ اللّٰهِ",
      "translation": ""
    },
    {
      "index": 2,
      "arabic": "اَلسَّلَامُ عَلٰى نُوْحٍ نَبِيِّ اللّٰهِ",
      "translation": ""
    },
    {
      "index": 3,
      "arabic": "اَلسَّلَامُ عَلٰىۤ اِبْرَاهِيْمَ خَلِيْلِ اللّٰهِ",
      "translation": ""
    },
    {
      "index": 4,
      "arabic": "اَلسَّلَامُ عَلٰى مُوْسٰى كَلِيْمِ اللّٰهِ",
      "translation": ""
    },
    {
      "index": 5,
      "arabic": "اَلسَّلَامُ عَلٰى عِيْسٰى رُوْحِ اللّٰهِ",
      "translation": ""
    },
    {
      "index": 6,
      "arabic": "اَلسَّلَامُ عَلَيْكَ يَا رَسُوْلَ اللّٰهِ",
      "translation": ""
    },
    {
      "index": 7,
      "arabic": "اَلسَّلَامُ عَلَيْكَ يَا خَيْرَ خَلْقِ اللّٰهِ",
      "translation": ""
    },
    {
      "index": 8,
      "arabic": "اَلسَّلَامُ عَلَيْكَ يَا صَفِيَّ اللّٰهِ",
      "translation": ""
    },
    {
      "index": 9,
      "arabic": "اَلسَّلَامُ عَلَيْكَ يَا مُحَمَّدَ بْنَ عَبْدِ اللّٰهِ",
      "translation": ""
    },
    {
      "index": 10,
      "arabic": "خَاتَمَ النَّبِيِّيْنَ",
      "translation": ""
    },
    {
      "index": 11,
      "arabic": "اَلسَّلَامُ عَلَيْكَ يَاۤ اَمِيْرَ الْمُؤْمِنِيْنَ",
      "translation": ""
    },
    {
      "index": 12,
      "arabic": "عَلِيَّ بْنَ اَبِيْ طَالِبٍ",
      "translation": ""
    },
    {
      "index": 13,
      "arabic": "وَصِيَّ رَسُوْلِ اللّٰهِ",
      "translation": ""
    },
    {
      "index": 14,
      "arabic": "اَلسَّلَامُ عَلَيْكِ يَا فَاطِمَةُ",
      "translation": ""
    },
    {
      "index": 15,
      "arabic": "سَيِّدَةَ نِسَاۤءِ الْعَالَمِيْنَ",
      "translation": ""
    },
    {
      "index": 16,
      "arabic": "اَلسَّلَامُ عَلَيْكُمَا يَا سِبْطَيِ الرَّحْمَةِ",
      "translation": ""
    },
    {
      "index": 17,
      "arabic": "وَ سَيِّدَيْ شَبَابِ اَهْلِ الْجَنَّةِ",
      "translation": ""
    },
    {
      "index": 18,
      "arabic": "اَلسَّلَامُ عَلَيْكَ يَا عَلِيَّ بْنَ الْحُسَيْنِ",
      "translation": ""
    },
    {
      "index": 19,
      "arabic": "سَيِّدَ الْعَابِدِيْنَ وَ قُرَّةَ عَيْنِ النَّاظِرِيْنَ",
      "translation": ""
    },
    {
      "index": 20,
      "arabic": "اَلسَّلَامُ عَلَيْكَ يَا مُحَمَّدَ بْنَ عَلِيٍّ",
      "translation": ""
    },
    {
      "index": 21,
      "arabic": "بَاقِرَ الْعِلْمِ بَعْدَ النَّبِيِّ",
      "translation": ""
    },
    {
      "index": 22,
      "arabic": "اَلسَّلَامُ عَلَيْكَ يَا جَعْفَرَ بْنَ مُحَمَّدٍ",
      "translation": ""
    },
    {
      "index": 23,
      "arabic": "۟اِلصَّادِقَ الْبَآرَّ الْاَمِيْنَ",
      "translation": ""
    },
    {
      "index": 24,
      "arabic": "اَلسَّلَامُ عَلَيْكَ يَا مُوْسَى بْنَ جَعْفَرٍ",
      "translation": ""
    },
    {
      "index": 25,
      "arabic": "۟اِلطَّاهِرَ الطُّهْرَ",
      "translation": ""
    },
    {
      "index": 26,
      "arabic": "اَلسَّلَامُ عَلَيْكَ يَا عَلِيَّ بْنَ مُوْسَى",
      "translation": ""
    },
    {
      "index": 27,
      "arabic": "الرِّضَا الْمُرْتَضٰى",
      "translation": ""
    },
    {
      "index": 28,
      "arabic": "اَلسَّلَامُ عَلَيْكَ يَا مُحَمَّدَ بْنَ عَلِيٍّ ۟اِلتَّقِيَّ",
      "translation": ""
    },
    {
      "index": 29,
      "arabic": "اَلسَّلَامُ عَلَيْكَ يَا عَلِيَّ بْنَ مُحَمَّدٍ",
      "translation": ""
    },
    {
      "index": 30,
      "arabic": "۟اِلنَّقِيَّ النَّاصِحَ الْاَمِيْنَ",
      "translation": ""
    },
    {
      "index": 31,
      "arabic": "اَلسَّلَامُ عَلَيْكَ يَا حَسَنَ بْنَ عَلِيٍّ",
      "translation": ""
    },
    {
      "index": 32,
      "arabic": "اَلسَّلَامُ عَلَى الْوَصِيِّ مِنْ بَعْدِهِ",
      "translation": ""
    },
    {
      "index": 33,
      "arabic": "اَللّٰهُمَّ صَلِّ عَلٰى نُوْرِكَ وَ سِرَاجِكَ",
      "translation": ""
    },
    {
      "index": 34,
      "arabic": "وَ وَلِيِّ وَلِيِّكَ",
      "translation": ""
    },
    {
      "index": 35,
      "arabic": "وَ وَصِيِّ وَصِيِّكَ",
      "translation": ""
    },
    {
      "index": 36,
      "arabic": "وَ حُجَّتِكَ عَلٰى خَلْقِكَ",
      "translation": ""
    },
    {
      "index": 37,
      "arabic": "اَلسَّلَامُ عَلَيْكَ اَيُّهَا السَّيِّدُ الزَّكِيُّ",
      "translation": ""
    },
    {
      "index": 38,
      "arabic": "وَ الطَّاهِرُ الصَّفِيُّ",
      "translation": ""
    },
    {
      "index": 39,
      "arabic": "اَلسَّلَامُ عَلَيْكَ يَا ابْنَ السَّادَةِ الْاَطْهَارِ",
      "translation": ""
    },
    {
      "index": 40,
      "arabic": "اَلسَّلَامُ عَلَيْكَ يَا ابْنَ الْمُصْطَفَيْنَ الْاَخْيَارِ",
      "translation": ""
    },
    {
      "index": 41,
      "arabic": "اَلسَّلَامُ عَلٰى رَسُولِ اللّٰهِ",
      "translation": ""
    },
    {
      "index": 42,
      "arabic": "وَ عَلٰى ذُرِّيَّةِ رَسُوْلِ اللّٰهِ",
      "translation": ""
    },
    {
      "index": 43,
      "arabic": "وَ رَحْمَةُ اللّٰهِ وَ بَرَكَاتُهُ۔",
      "translation": ""
    },
    {
      "index": 44,
      "arabic": "اَلسَّلَامُ عَلَى الْعَبْدِ الصَّالِحِ",
      "translation": ""
    },
    {
      "index": 45,
      "arabic": "الْمُطِيْعِ لِلّٰهِ رَبِّ الْعَالَمِيْنَ",
      "translation": ""
    },
    {
      "index": 46,
      "arabic": "وَ لِرَسُوْلِهِ وَ لِاَمِيْرِ الْمُؤْمِنِيْنَ",
      "translation": ""
    },
    {
      "index": 47,
      "arabic": "اَلسَّلَامُ عَلَيْكَ يَا اَبَا الْقَاسِمِ",
      "translation": ""
    },
    {
      "index": 48,
      "arabic": "ابْنَ السِّبْطِ الْمُنْتَجَبِ الْمُجْتَبٰى",
      "translation": ""
    },
    {
      "index": 49,
      "arabic": "اَلسَّلَامُ عَلَيْكَ يَا مَنْ بِزِيَارَتِهِ ثَوَابُ زِيَارَةِ سَيِّدِ الشُّهَدَاۤءِ يُرْتَجٰى",
      "translation": ""
    },
    {
      "index": 50,
      "arabic": "اَلسَّلَامُ عَلَيْكَ",
      "translation": ""
    },
    {
      "index": 51,
      "arabic": "عَرَّفَ اللّٰهُ بَيْنَنَا وَ بَيْنَكُمْ فِي الْجَنَّةِ",
      "translation": ""
    },
    {
      "index": 52,
      "arabic": "وَ حَشَرَنَا فِيْ زُمْرَتِكُمْ",
      "translation": ""
    },
    {
      "index": 53,
      "arabic": "وَ اَوْرَدَنَا حَوْضَ نَبِيِّكُمْ",
      "translation": ""
    },
    {
      "index": 54,
      "arabic": "وَ سَقَانَا بِكَأْسِ جَدِّكُمْ",
      "translation": ""
    },
    {
      "index": 55,
      "arabic": "مِنْ يَدِ عَلِيِّ بْنِ اَبِيْ طَالِبٍ",
      "translation": ""
    },
    {
      "index": 56,
      "arabic": "صَلَوَاتُ اللّٰهِ عَلَيْكُمْ",
      "translation": ""
    },
    {
      "index": 57,
      "arabic": "اَسْاَلُ اللّٰهَ اَنْ يُرِيَنَا فِيْكُمُ السُّرُوْرَ وَ الْفَرَجَ",
      "translation": ""
    },
    {
      "index": 58,
      "arabic": "وَ اَنْ يَجْمَعَنَا وَ اِيَّاكُمْ فِيْ زُمْرَةِ جَدِّكُمْ",
      "translation": ""
    },
    {
      "index": 59,
      "arabic": "مُحَمَّدٍ صَلَّى اللّٰهُ عَلَيْهِ وَ اٰلِهِ",
      "translation": ""
    },
    {
      "index": 60,
      "arabic": "وَ اَنْ لَا يَسْلُبَنَا مَعْرِفَتَكُمْ",
      "translation": ""
    },
    {
      "index": 61,
      "arabic": "اِنَّهُ وَلِيٌّ قَدِيْرٌ",
      "translation": ""
    },
    {
      "index": 62,
      "arabic": "اَتَقَرَّبُ اِلَى اللّٰهِ بِحُبِّكُمْ",
      "translation": ""
    },
    {
      "index": 63,
      "arabic": "وَ الْبَرَاۤءَةِ مِنْ اَعْدَاۤئِكُمْ",
      "translation": ""
    },
    {
      "index": 64,
      "arabic": "وَ التَّسْلِيْمِ اِلَى اللّٰهِ",
      "translation": ""
    },
    {
      "index": 65,
      "arabic": "رَاضِيًا بِهِ غَيْرَ مُنْكَرٍ وَ لَا مُسْتَكْبِرٍ",
      "translation": ""
    },
    {
      "index": 66,
      "arabic": "وَ عَلٰى يَقِيْنِ مَا اَتٰى بِهِ مُحَمَّدٌ",
      "translation": ""
    },
    {
      "index": 67,
      "arabic": "وَ بِهِ رَاضٍ",
      "translation": ""
    },
    {
      "index": 68,
      "arabic": "نَطْلُبُ بِذٰلِكَ وَجْهَكَ",
      "translation": ""
    },
    {
      "index": 69,
      "arabic": "يَا سَيِّدِيْ اَللّٰهُمَّ وَ رِضَاكَ",
      "translation": ""
    },
    {
      "index": 70,
      "arabic": "وَ الدَّارَ الْاٰخِرَةَ",
      "translation": ""
    },
    {
      "index": 71,
      "arabic": "يَا سَيِّدِيْ وَ ابْنَ سَيِّدِيْ اِشْفَعْ لِيْ فِي الْجَنَّةِ",
      "translation": ""
    },
    {
      "index": 72,
      "arabic": "فَاِنَّ لَكَ عِنْدَ اللّٰهِ شَأْنًا مِنَ الشَّأْنِ",
      "translation": ""
    },
    {
      "index": 73,
      "arabic": "اَللّٰهُمَّ اِنِّيۤ اَسْاَلُكَ اَنْ تَخْتِمَ لِيْ بِالسَّعَادَةِ",
      "translation": ""
    },
    {
      "index": 74,
      "arabic": "فَلَا تَسْلُبْ مِنِّيْ مَا اَنَا فِيْهِ",
      "translation": ""
    },
    {
      "index": 75,
      "arabic": "وَ لَا حَوْلَ وَ لَا قُوَّةَ اِلَّا بِاللّٰهِ الْعَلِيِّ الْعَظِيْمِ",
      "translation": ""
    },
    {
      "index": 76,
      "arabic": "اَللّٰهُمَّ اسْتَجِبْ لَنَا",
      "translation": ""
    },
    {
      "index": 77,
      "arabic": "وَ تَقَبَّلْهُ بِكَرَمِكَ وَ عِزَّتِكَ",
      "translation": ""
    },
    {
      "index": 78,
      "arabic": "وَ بِرَحْمَتِكَ وَ عَافِيَتِكَ",
      "translation": ""
    },
    {
      "index": 79,
      "arabic": "وَ صَلَّى اللّٰهُ عَلٰى مُحَمَّدٍ وَ اٰلِهِ اَجْمَعِيْنَ",
      "translation": ""
    },
    {
      "index": 80,
      "arabic": "وَ سَلَّمَ تَسْلِيْمًا يَاۤ اَرْحَمَ الرَّاحِمِيْنَ۔",
      "translation": ""
    }
  ],
