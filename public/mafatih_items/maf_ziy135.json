      "arabic": "وَ مُوَالَاتَكَ بِمُوَالَاتِهِ",
      "translation": ""
    },
    {
      "index": 56,
      "arabic": "تَوَلَّ صَلَاحَ حَالِى مَعَ اللّٰهِ عَزَّ وَ جَلَّ",
      "translation": ""
    },
    {
      "index": 57,
      "arabic": "وَ اجْعَلْ حَظِّيْ مِنْ زِيَارَتِكَ",
      "translation": ""
    },
    {
      "index": 58,
      "arabic": "تَخْلِيْطِيْ بِخَالِصِيْ زُوَّارِكَ",
      "translation": ""
    },
    {
      "index": 59,
      "arabic": "الَّذِيْنَ تَسْاَلُ اللّٰهَ عَزَّ وَ جَلَّ فِي عِتْقِ رِقَابِهِمْ",
      "translation": ""
    },
    {
      "index": 60,
      "arabic": "وَ تَرْغَبُ اِلَيْهِ فِيْ حُسْنِ ثَوَابِهِمْ",
      "translation": ""
    },
    {
      "index": 61,
      "arabic": "وَ هَاۤ اَنَا الْيَوْمَ بِقَبْرِكَ لَاۤئِذٌ",
      "translation": ""
    },
    {
      "index": 62,
      "arabic": "وَ بِحُسْنِ دِفَاعِكَ عَنِّيْ عَاۤئِذٌ",
      "translation": ""
    },
    {
      "index": 63,
      "arabic": "فَتَلَافَنِيْ يَا مَوْلَايَ وَ اَدْرِكْنِيْ",
      "translation": ""
    },
    {
      "index": 64,
      "arabic": "وَ اَسْاَلِ اللّٰهَ عَزَّ وَ جَلَّ فِيۤ اَمْرِيْ",
      "translation": ""
    },
    {
      "index": 65,
      "arabic": "فَاِنَّ لَكَ عِنْدَ اللّٰهِ مَقَامًا كَرِيْمًا",
