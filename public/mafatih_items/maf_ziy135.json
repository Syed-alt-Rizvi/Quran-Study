      "arabic": "بَلَغَ مَجْهُوْدِيْ",
      "translation": ""
    },
    {
      "index": 28,
      "arabic": "فَهَبْ لِيْ نَفْسِيَ السَّاعَةَ",
      "translation": ""
    },
    {
      "index": 29,
      "arabic": "وَ رَحْمَةً مِنْكَ تَمُنُّ بِهَا عَلَيَّ",
      "translation": ""
    },
    {
      "index": 30,
      "arabic": "يَاۤ اَرْحَمَ الرَّاحِمِيْنَ۔",
      "translation": ""
    },
    {
      "index": 31,
      "arabic": "اَللّٰهُمَّ اِنَّ هٰذَا مَشْهَدٌ لَا يَرْجُوْ مَنْ فَاتَتْهُ فِيْهِ رَحْمَتُكَ",
      "translation": ""
    },
    {
      "index": 32,
      "arabic": "اَنْ يَّنَالَهَا فِي غَيْرِهِ",
      "translation": ""
    },
    {
      "index": 33,
      "arabic": "وَ لَاۤ اَحَدٌ اَشْقٰى مِنِ امْرِئٍ قَصَدَهُ مُؤَمِّلًا فَاٰبَ عَنْهُ خَاۤئِبًا",
      "translation": ""
    },
    {
      "index": 34,
      "arabic": "اَللّٰهُمَّ اِنِّيۤ اَعُوْذُ بِكَ مِنْ شَرِّ الْاِيَابِ",
      "translation": ""
    },
    {
      "index": 35,
      "arabic": "وَ خَيْبَةِ الْمُنْقَلَبِ",
      "translation": ""
    },
    {
      "index": 36,
      "arabic": "وَ الْمُنَاقَشَةِ عِنْدَ الْحِسَابِ",
      "translation": ""
    },
    {
      "index": 37,
      "arabic": "وَ حَاشَاكَ يَا رَبِّ اَنْ تَقْرِنَ طَاعَةَ وَلِيِّكَ بِطَاعَتِكَ",
      "translation": ""
    },
    {
      "index": 38,
      "arabic": "وَ مُوَالَاتَهُ بِمُوَالَاتِكَ",
      "translation": ""
    },
    {
      "index": 39,
      "arabic": "وَ مَعْصِيَتَهُ بِمَعْصِيَتِكَ",
      "translation": ""
    },
    {
      "index": 40,
      "arabic": "ثُمَّ تُؤْيِسَ زَاۤئِرَهُ",
      "translation": ""
    },
    {
      "index": 41,
      "arabic": "وَ الْمُتَحَمِّلَ مِنْ بُعْدِ الْبِلَادِ اِلٰى قَبْرِهِ",
      "translation": ""
    },
    {
      "index": 42,
      "arabic": "وَ عِزَّتِكَ يَا رَبِّ",
      "translation": ""
    },
    {
