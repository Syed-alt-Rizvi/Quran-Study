      "arabic": "سَلَامَ مُوَدِّعٍ لَا سَئِمٍ وَ لَا قَالٍ",
      "translation": ""
    },
    {
      "index": 48,
      "arabic": "وَ رَحْمَةُ اللّٰهِ وَ بَرَكَاتُهُ۔",
      "translation": ""
    },
    {
      "index": 49,
      "arabic": "يَا وَلِيَّ اللّٰهِ",
      "translation": ""
    },
    {
      "index": 50,
      "arabic": "اِنَّ بَيْنِيْ وَ بَيْنَ اللّٰهِ عَزَّ وَ جَلَّ ذُنُوْبًا",
      "translation": ""
    },
    {
      "index": 51,
      "arabic": "لَا يَأْتِيْ عَلَيْهَاۤ اِلَّا رِضَاكَ",
      "translation": ""
    },
    {
      "index": 52,
      "arabic": "فَبِحَقِّ مَنِ ائْتَمَنَكَ عَلٰى سِرِّهِ",
      "translation": ""
    },
    {
      "index": 53,
      "arabic": "وَ اسْتَرْعَاكَ اَمْرَ خَلْقِهِ",
      "translation": ""
    },
    {
      "index": 54,
      "arabic": "وَ قَرَنَ طَاعَتَكَ بِطَاعَتِهِ",
