  "verses": [
    {
      "index": 1,
      "arabic": "اَللّٰهُمَّ غَشِّنِيْ فِيْهِ بِالرَّحْمَةِ،",
      "translation": "O Allah, on this day, (please) spread out mercy over me,"
    },
    {
      "index": 2,
      "arabic": "وَارْزُقْنِيْ فِيْهِ التَّوْفِيْقَ وَالْعِصْمَةَ،",
      "translation": "provide me with success and protection (against sinning),"
    },
    {
      "index": 3,
      "arabic": "وَطَهِّرْ قَلْبِيْ مِنْ غَيَاهِبِ التُّهْمَةِ،",
      "translation": "and cleanse my heart from the murk of doubt."
    },
    {
      "index": 4,
      "arabic": "يَا رَحِيْمًا بِعِبَادِهِ الْمُؤْمِنِيْنَ۔",
      "translation": "O He Who is merciful to His faithful servants!"
    }
  ],
