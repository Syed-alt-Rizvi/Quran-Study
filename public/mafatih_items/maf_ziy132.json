    {
      "index": 111,
      "arabic": "وَ اَذْهَبَ عَنْكُمُ الرِّجْسَ",
      "translation": ""
    },
    {
      "index": 112,
      "arabic": "وَ طَهَّرَكُمْ تَطْهِيْرًا",
      "translation": ""
    },
    {
      "index": 113,
      "arabic": "فَعَظَّمْتُمْ جَلَالَهُ",
      "translation": ""
    },
    {
      "index": 114,
      "arabic": "وَ اَكْبَرْتُمْ شَأْنَهُ",
      "translation": ""
    },
    {
      "index": 115,
      "arabic": "وَ مَجَّدْتُمْ كَرَمَهُ",
      "translation": ""
    },
    {
      "index": 116,
      "arabic": "وَ اَدَمْتُمْ [اَدْمَنْتُمْ‏] ذِكْرَهُ",
      "translation": ""
    },
    {
      "index": 117,
      "arabic": "وَ وَكَّدْتُمْ [ذَكَّرْتُمْ‏] مِيْثَاقَهُ",
      "translation": ""
    },
    {
      "index": 118,
      "arabic": "وَ اَحْكَمْتُمْ عَقْدَ طَاعَتِهِ",
      "translation": ""
    },
    {
      "index": 119,
      "arabic": "وَ نَصَحْتُمْ لَهُ فِي السِّرِّ وَ الْعَلَانِيَةِ",
      "translation": ""
    },
    {
      "index": 120,
      "arabic": "وَ دَعَوْتُمْ اِلٰى سَبِيْلِهِ",
      "translation": ""
    },
    {
      "index": 121,
      "arabic": "بِالْحِكْمَةِ وَ الْمَوْعِظَةِ الْحَسَنَةِ",
      "translation": ""
    },
    {
      "index": 122,
      "arabic": "وَ بَذَلْتُمْ اَنْفُسَكُمْ فِيْ مَرْضَاتِهِ",
      "translation": ""
    },
    {
      "index": 123,
      "arabic": "وَ صَبَرْتُمْ عَلٰى مَا اَصَابَكُمْ فِيْ جَنْبِهِ [حُبِّهِ‏]",
      "translation": ""
    },
    {
      "index": 124,
      "arabic": "وَ اَقَمْتُمُ الصَّلٰوةَ",
      "translation": ""
    },
    {
      "index": 125,
      "arabic": "وَ اٰتَيْتُمُ الزَّكَاةَ",
      "translation": ""
    },
    {
      "index": 126,
      "arabic": "وَ اَمَرْتُمْ بِالْمَعْرُوْفِ",
      "translation": ""
    },
    {
      "index": 127,
      "arabic": "وَ نَهَيْتُمْ عَنِ الْمُنْكَرِ",
      "translation": ""
    },
    {
      "index": 128,
      "arabic": "وَ جَاهَدْتُمْ فِيْ اللّٰهِ حَقَّ جِهَادِهِ",
      "translation": ""
    },
    {
      "index": 129,
      "arabic": "حَتّٰىۤ اَعْلَنْتُمْ دَعْوَتَهُ",
      "translation": ""
    },
    {
      "index": 130,
      "arabic": "وَ بَيَّنْتُمْ فَرَاۤئِضَهُ",
      "translation": ""
    },
    {
      "index": 131,
      "arabic": "وَ اَقَمْتُمْ حُدُوْدَهُ",
      "translation": ""
    },
    {
      "index": 132,
      "arabic": "وَ نَشَرْتُمْ [وَ فَسَّرْتُمْ‏] شَرَاۤئِعَ اَحْكَامِهِ",
      "translation": ""
    },
    {
      "index": 133,
      "arabic": "وَ سَنَنْتُمْ سُنَّتَهُ",
      "translation": ""
    },
    {
      "index": 134,
      "arabic": "وَ صِرْتُمْ فِيْ ذٰلِكَ مِنْهُ اِلَى الرِّضَا",
      "translation": ""
    },
    {
      "index": 135,
      "arabic": "وَ سَلَّمْتُمْ لَهُ الْقَضَاۤءَ",
      "translation": ""
    },
    {
      "index": 136,
      "arabic": "وَ صَدَّقْتُمْ مِنْ رُسُلِهِ مَنْ مَضٰى",
      "translation": ""
    },
    {
      "index": 137,
      "arabic": "فَالرَّاغِبُ عَنْكُمْ مَارِقٌ",
      "translation": ""
    },
    {
      "index": 138,
      "arabic": "وَ اللَّازِمُ لَكُمْ لَاحِقٌ",
      "translation": ""
    },
    {
      "index": 139,
      "arabic": "وَ الْمُقَصِّرُ فِيْ حَقِّكُمْ زَاهِقٌ",
      "translation": ""
    },
    {
      "index": 140,
      "arabic": "وَ الْحَقُّ مَعَكُمْ وَ فِيْكُمْ",
      "translation": ""
    },
    {
      "index": 141,
      "arabic": "وَ مِنْكُمْ وَ اِلَيْكُمْ",
      "translation": ""
    },
    {
      "index": 142,
      "arabic": "وَ اَنْتُمْ اَهْلُهُ وَ مَعْدِنُهُ",
      "translation": ""
    },
    {
      "index": 143,
      "arabic": "وَ مِيْرَاثُ النُّبُوَّةِ عِنْدَكُمْ",
      "translation": ""
    },
    {
      "index": 144,
      "arabic": "وَ اِيَابُ الْخَلْقِ اِلَيْكُمْ",
      "translation": ""
    },
    {
      "index": 145,
      "arabic": "وَ حِسَابُهُمْ عَلَيْكُمْ",
      "translation": ""
    },
    {
      "index": 146,
      "arabic": "وَ فَصْلُ الْخِطَابِ عِنْدَكُمْ",
      "translation": ""
    },
    {
      "index": 147,
      "arabic": "وَ اٰيَاتُ اللّٰهِ لَدَيْكُمْ",
      "translation": ""
    },
    {
      "index": 148,
      "arabic": "وَ عَزَاۤئِمُهُ فِيْكُمْ",
      "translation": ""
    },
    {
      "index": 149,
      "arabic": "وَ نُوْرُهُ وَ بُرْهَانُهُ عِنْدَكُمْ",
      "translation": ""
    },
    {
      "index": 150,
      "arabic": "وَ اَمْرُهُ اِلَيْكُمْ",
      "translation": ""
    },
    {
      "index": 151,
      "arabic": "مَنْ وَالَاكُمْ فَقَدْ وَالَى اللّٰهَ",
      "translation": ""
    },
    {
      "index": 152,
      "arabic": "وَ مَنْ عَادَاكُمْ فَقَدْ عَادَى اللّٰهَ",
      "translation": ""
    },
    {
      "index": 153,
      "arabic": "وَ مَنْ اَحَبَّكُمْ فَقَدْ اَحَبَّ اللّٰهَ",
      "translation": ""
    },
    {
      "index": 154,
      "arabic": "وَ مَنْ اَبْغَضَكُمْ فَقَدْ اَبْغَضَ اللّٰهَ‏",
      "translation": ""
    },
    {
      "index": 155,
      "arabic": "وَ مَنِ اعْتَصَمَ بِكُمْ فَقَدِ اعْتَصَمَ بِاللّٰهِ",
      "translation": ""
    },
    {
      "index": 156,
      "arabic": "اَنْتُمُ الصِّرَاطُ الْاَقْوَمُ",
      "translation": ""
    },
    {
      "index": 157,
      "arabic": "وَ شُهَدَاۤءُ دَارِ الْفَنَاۤءِ",
      "translation": ""
    },
    {
      "index": 158,
      "arabic": "وَ شُفَعَاۤءُ دَارِ الْبَقَاۤءِ",
      "translation": ""
    },
    {
      "index": 159,
      "arabic": "وَ الرَّحْمَةُ الْمَوْصُوْلَةُ",
      "translation": ""
    },
    {
      "index": 160,
      "arabic": "وَ الْاٰيَةُ الْمَخْزُوْنَةُ",
      "translation": ""
    },
    {
      "index": 161,
      "arabic": "وَ الْاَمَانَةُ الْمَحْفُوْظَةُ",
      "translation": ""
    },
    {
      "index": 162,
      "arabic": "وَ الْبَابُ الْمُبْتَلٰى بِهِ النَّاسُ",
      "translation": ""
    },
    {
      "index": 163,
      "arabic": "مَنْ اَتَاكُمْ نَجَا",
      "translation": ""
    },
    {
      "index": 164,
      "arabic": "وَ مَنْ لَمْ يَأْتِكُمْ هَلَكَ",
      "translation": ""
    },
    {
      "index": 165,
      "arabic": "اِلَى اللّٰهِ تَدْعُوْنَ",
      "translation": ""
    },
    {
      "index": 166,
      "arabic": "وَ عَلَيْهِ تَدُلُّوْنَ",
      "translation": ""
    },
    {
      "index": 167,
      "arabic": "وَ بِهِ تُؤْمِنُونَ",
      "translation": ""
    },
    {
      "index": 168,
      "arabic": "وَ لَهُ تُسَلِّمُوْنَ",
      "translation": ""
    },
    {
      "index": 169,
      "arabic": "وَ بِاَمْرِهِ تَعْمَلُوْنَ",
      "translation": ""
    },
    {
      "index": 170,
      "arabic": "وَ اِلٰى سَبِيْلِهِ تُرْشِدُوْنَ",
      "translation": ""
    },
    {
      "index": 171,
      "arabic": "وَ بِقَوْلِهِ تَحْكُمُوْنَ",
      "translation": ""
    },
    {
      "index": 172,
      "arabic": "سَعَدَ مَنْ وَالَاكُمْ",
      "translation": ""
    },
    {
      "index": 173,
      "arabic": "وَ هَلَكَ مَنْ عَادَاكُمْ",
      "translation": ""
    },
    {
      "index": 174,
      "arabic": "وَ خَابَ مَنْ جَحَدَكُمْ",
      "translation": ""
    },
    {
      "index": 175,
      "arabic": "وَ ضَلَّ مَنْ فَارَقَكُمْ",
      "translation": ""
    },
    {
      "index": 176,
      "arabic": "وَ فَازَ مَنْ تَمَسَّكَ بِكُمْ",
      "translation": ""
    },
    {
      "index": 177,
      "arabic": "وَ اَمِنَ مَنْ لَجَاَ اِلَيْكُمْ",
      "translation": ""
    },
    {
      "index": 178,
      "arabic": "وَ سَلِمَ مَنْ صَدَّقَكُمْ",
      "translation": ""
    },
    {
      "index": 179,
      "arabic": "وَ هُدِيَ مَنِ اعْتَصَمَ بِكُمْ",
      "translation": ""
    },
    {
      "index": 180,
      "arabic": "مَنِ اتَّبَعَكُمْ فَالْجَنَّةُ مَأْوَاهُ",
      "translation": ""
    },
    {
      "index": 181,
      "arabic": "وَ مَنْ خَالَفَكُمْ فَالنَّارُ مَثْوَاهُ",
      "translation": ""
    },
    {
      "index": 182,
      "arabic": "وَ مَنْ جَحَدَكُمْ كَافِرٌ",
      "translation": ""
    },
    {
      "index": 183,
      "arabic": "وَ مَنْ حَارَبَكُمْ مُشْرِكٌ",
      "translation": ""
    },
    {
      "index": 184,
      "arabic": "وَ مَنْ رَدَّ عَلَيْكُمْ فِيۤ اَسْفَلِ دَرْكٍ مِنَ الْجَحِيْمِ",
      "translation": ""
    },
    {
      "index": 185,
      "arabic": "اَشْهَدُ اَنَّ هٰذَا سَابِقٌ لَكُمْ فِيْمَا مَضٰى",
      "translation": ""
    },
    {
      "index": 186,
      "arabic": "وَ جَارٍ لَكُمْ فِيْمَا بَقِيَ",
      "translation": ""
    },
    {
      "index": 187,
      "arabic": "وَ اَنَّ اَرْوَاحَكُمْ وَ نُوْرَكُمْ",
      "translation": ""
    },
    {
      "index": 188,
      "arabic": "وَ طِيْنَتَكُمْ وَاحِدَةٌ",
      "translation": ""
    },
    {
      "index": 189,
      "arabic": "طَابَتْ وَ طَهُرَتْ",
      "translation": ""
    },
    {
      "index": 190,
      "arabic": "بَعْضُهَا مِنْ بَعْضٍ",
      "translation": ""
    },
    {
      "index": 191,
      "arabic": "خَلَقَكُمُ اللّٰهُ اَنْوَارًا",
      "translation": ""
    },
    {
      "index": 192,
      "arabic": "فَجَعَلَكُمْ بِعَرْشِهِ مُحْدِقِيْنَ",
      "translation": ""
    },
    {
      "index": 193,
      "arabic": "حَتّٰى مَنَّ عَلَيْنَا بِكُمْ",
      "translation": ""
    },
    {
      "index": 194,
      "arabic": "فَجَعَلَكُمْ فِيْ بُيُوْتٍ",
      "translation": ""
    },
    {
      "index": 195,
      "arabic": "اَذِنَ اللّٰهُ اَنْ تُرْفَعَ",
      "translation": ""
    },
    {
      "index": 196,
      "arabic": "وَ يُذْكَرَ فِيْهَا اسْمُهُ",
      "translation": ""
    },
    {
      "index": 197,
      "arabic": "وَ جَعَلَ صَلَاتَنَا [صَلَوَاتِنَا] عَلَيْكُمْ",
      "translation": ""
    },
    {
      "index": 198,
      "arabic": "وَ مَا خَصَّنَا بِهِ مِنْ وِلَايَتِكُمْ",
      "translation": ""
    },
    {
      "index": 199,
      "arabic": "طِيْبًا لِخَلْقِنَا [لِخُلُقِنَا]",
      "translation": ""
    },
    {
      "index": 200,
      "arabic": "وَ طَهَارَةً لِاَنْفُسِنَا",
      "translation": ""
    },
    {
      "index": 201,
      "arabic": "وَ تَزْكِيَةً [بَرَكَةً] لَنَا",
      "translation": ""
    },
    {
      "index": 202,
      "arabic": "وَ كَفَّارَةً لِذُنُوْبِنَا",
      "translation": ""
    },
    {
      "index": 203,
      "arabic": "فَكُنَّا عِنْدَهُ مُسَلِّمِيْنَ بِفَضْلِكُمْ",
      "translation": ""
    },
    {
      "index": 204,
      "arabic": "وَ مَعْرُوْفِيْنَ بِتَصْدِيْقِنَاۤ اِيَّاكُمْ",
      "translation": ""
    },
    {
      "index": 205,
      "arabic": "فَبَلَغَ اللّٰهُ بِكُمْ اَشْرَفَ مَحَلِّ الْمُكَرَّمِيْنَ",
      "translation": ""
    },
    {
      "index": 206,
      "arabic": "وَ اَعْلٰى مَنَازِلِ الْمُقَرَّبِيْنَ",
      "translation": ""
    },
    {
      "index": 207,
      "arabic": "وَ اَرْفَعَ دَرَجَاتِ الْمُرْسَلِيْنَ",
      "translation": ""
    },
    {
      "index": 208,
      "arabic": "حَيْثُ لَا يَلْحَقُهُ لَاحِقٌ",
      "translation": ""
    },
    {
      "index": 209,
      "arabic": "وَ لَا يَفُوْقُهُ فَاۤئِقٌ",
      "translation": ""
    },
    {
      "index": 210,
      "arabic": "وَ لَا يَسْبِقُهُ سَابِقٌ",
      "translation": ""
    },
    {
      "index": 211,
      "arabic": "وَ لَا يَطْمَعُ فِيۤ اِدْرَاكِهِ طَامِعٌ",
      "translation": ""
    },
    {
      "index": 212,
      "arabic": "حَتّٰى لَا يَبْقٰى مَلَكٌ مُقَرَّبٌ",
      "translation": ""
    },
    {
      "index": 213,
      "arabic": "وَ لَا نَبِيٌّ مُرْسَلٌ",
      "translation": ""
    },
    {
      "index": 214,
      "arabic": "وَ لَا صِدِّيْقٌ وَ لَا شَهِيْدٌ",
      "translation": ""
    },
    {
      "index": 215,
      "arabic": "وَ لَا عَالِمٌ وَ لَا جَاهِلٌ",
      "translation": ""
    },
    {
      "index": 216,
      "arabic": "وَ لَا دَنِيٌّ وَ لَا فَاضِلٌ",
      "translation": ""
    },
    {
      "index": 217,
      "arabic": "وَ لَا مُؤْمِنٌ صَالِحٌ",
      "translation": ""
    },
    {
      "index": 218,
      "arabic": "وَ لَا فَاجِرٌ طَالِحٌ",
      "translation": ""
    },
    {
      "index": 219,
      "arabic": "وَ لَا جَبَّارٌ عَنِيْدٌ",
      "translation": ""
    },
    {
      "index": 220,
      "arabic": "وَ لَا شَيْطَانٌ مَرِيْدٌ",
      "translation": ""
    },
    {
      "index": 221,
      "arabic": "وَ لَا خَلْقٌ فِيْمَا بَيْنَ ذٰلِكَ شَهِيْدٌ",
      "translation": ""
    },
    {
      "index": 222,
      "arabic": "اِلَّا عَرَّفَهُمْ جَلَالَةَ اَمْرِكُمْ",
      "translation": ""
    },
    {
      "index": 223,
      "arabic": "وَ عِظَمَ خَطَرِكُمْ",
      "translation": ""
    },
    {
      "index": 224,
      "arabic": "وَ كِبَرَ شَأْنِكُمْ",
      "translation": ""
    },
    {
      "index": 225,
      "arabic": "وَ تَمَامَ نُوْرِكُمْ",
      "translation": ""
    },
    {
      "index": 226,
      "arabic": "وَ صِدْقَ مَقَاعِدِكُمْ",
      "translation": ""
    },
    {
      "index": 227,
      "arabic": "وَ ثَبَاتَ مَقَامِكُمْ",
      "translation": ""
    },
    {
      "index": 228,
      "arabic": "وَ شَرَفَ مَحَلِّكُمْ وَ مَنْزِلَتِكُمْ عِنْدَهُ",
      "translation": ""
    },
    {
      "index": 229,
      "arabic": "وَ كَرَامَتَكُمْ عَلَيْهِ",
      "translation": ""
    },
    {
      "index": 230,
      "arabic": "وَ خَآصَّتَكُمْ لَدَيْهِ",
      "translation": ""
    },
    {
      "index": 231,
      "arabic": "وَ قُرْبَ مَنْزِلَتِكُمْ مِنْهُ",
      "translation": ""
    },
    {
      "index": 232,
      "arabic": "بِاَبِيۤ اَنْتُمْ وَ اُمِّيْ",
      "translation": ""
    },
    {
      "index": 233,
      "arabic": "وَ اَهْلِيْ وَ مَالِيْ وَ اُسْرَتِيۤ",
      "translation": ""
    },
    {
      "index": 234,
      "arabic": "اُشْهِدُ اللّٰهَ وَ اُشْهِدُكُمْ",
      "translation": ""
    },
    {
      "index": 235,
      "arabic": "اَنِّيْ مُؤْمِنٌ بِكُمْ وَ بِمَاۤ اٰمَنْتُمْ بِهِ",
      "translation": ""
    },
    {
      "index": 236,
      "arabic": "كَافِرٌ بِعَدُوِّكُمْ وَ بِمَا كَفَرْتُمْ بِهِ",
      "translation": ""
    },
    {
      "index": 237,
      "arabic": "مُسْتَبْصِرٌ بِشَأْنِكُمْ",
      "translation": ""
    },
    {
      "index": 238,
      "arabic": "وَ بِضَلَالَةِ مَنْ خَالَفَكُمْ",
      "translation": ""
    },
    {
      "index": 239,
      "arabic": "مُوَالٍ لَكُمْ وَ لِاَوْلِيَاۤئِكُمْ",
      "translation": ""
    },
    {
      "index": 240,
      "arabic": "مُبْغِضٌ لِاَعْدَاۤئِكُمْ وَ مُعَادٍ لَهُمْ",
      "translation": ""
    },
    {
      "index": 241,
      "arabic": "سِلْمٌ لِمَنْ سَالَمَكُمْ",
      "translation": ""
    },
    {
      "index": 242,
      "arabic": "وَ حَرْبٌ لِمَنْ حَارَبَكُمْ",
      "translation": ""
    },
    {
      "index": 243,
      "arabic": "مُحَقِّقٌ لِمَا حَقَّقْتُمْ",
      "translation": ""
    },
    {
      "index": 244,
      "arabic": "مُبْطِلٌ لِمَاۤ اَبْطَلْتُمْ",
      "translation": ""
    },
    {
      "index": 245,
      "arabic": "مُطِيْعٌ لَكُمْ",
      "translation": ""
    },
    {
      "index": 246,
      "arabic": "عَارِفٌ بِحَقِّكُمْ",
      "translation": ""
    },
    {
      "index": 247,
      "arabic": "مُقِرٌّ بِفَضْلِكُمْ",
      "translation": ""
    },
    {
      "index": 248,
      "arabic": "مُحْتَمِلٌ لِعِلْمِكُمْ",
      "translation": ""
    },
    {
      "index": 249,
      "arabic": "مُحْتَجِبٌ بِذِمَّتِكُمْ",
      "translation": ""
    },
    {
      "index": 250,
      "arabic": "مُعْتَرِفٌ بِكُمْ",
      "translation": ""
    },
    {
      "index": 251,
      "arabic": "مُؤْمِنٌ بِاِيَابِكُمْ",
      "translation": ""
    },
    {
      "index": 252,
      "arabic": "مُصَدِّقٌ بِرَجْعَتِكُمْ",
      "translation": ""
    },
    {
      "index": 253,
      "arabic": "مُنْتَظِرٌ لِاَمْرِكُمْ",
      "translation": ""
    },
    {
      "index": 254,
      "arabic": "مُرْتَقِبٌ لِدَوْلَتِكُمْ",
      "translation": ""
    },
    {
      "index": 255,
      "arabic": "اٰخِذٌ بِقَوْلِكُمْ",
      "translation": ""
    },
    {
      "index": 256,
      "arabic": "عَامِلٌ بِاَمْرِكُمْ",
      "translation": ""
    },
    {
      "index": 257,
      "arabic": "مُسْتَجِيْرٌ بِكُمْ",
      "translation": ""
    },
    {
      "index": 258,
      "arabic": "زَاۤئِرٌ لَكُمْ",
      "translation": ""
    },
    {
      "index": 259,
      "arabic": "لَاۤئِذٌ عَاۤئِذٌ بِقُبُوْرِكُمْ",
      "translation": ""
    },
    {
      "index": 260,
      "arabic": "مُسْتَشْفِعٌ اِلَى اللّٰهِ عَزَّ وَ جَلَّ بِكُمْ",
      "translation": ""
    },
    {
      "index": 261,
      "arabic": "وَ مُتَقَرِّبٌ بِكُمْ اِلَيْهِ",
      "translation": ""
    },
    {
      "index": 262,
      "arabic": "وَ مُقَدِّمُكُمْ اَمَامَ طَلِبَتِيْ",
      "translation": ""
    },
    {
      "index": 263,
      "arabic": "وَ حَوَاۤئِجِيْ وَ اِرَادَتِيْ",
      "translation": ""
    },
    {
      "index": 264,
      "arabic": "فِي كُلِّ اَحْوَالِيْ وَ اُمُوْرِيْ",
      "translation": ""
    },
    {
      "index": 265,
      "arabic": "مُؤْمِنٌ بِسِرِّكُمْ وَ عَلَانِيَتِكُمْ",
      "translation": ""
    },
    {
      "index": 266,
      "arabic": "وَ شَاهِدِكُمْ وَ غَاۤئِبِكُمْ",
      "translation": ""
    },
    {
      "index": 267,
      "arabic": "وَ اَوَّلِكُمْ وَ اٰخِرِكُمْ",
      "translation": ""
    },
    {
      "index": 268,
      "arabic": "وَ مُفَوِّضٌ فِيْ ذٰلِكَ كُلِّهِ اِلَيْكُمْ",
      "translation": ""
    },
    {
      "index": 269,
      "arabic": "وَ مُسَلِّمٌ فِيْهِ مَعَكُمْ",
      "translation": ""
    },
    {
      "index": 270,
      "arabic": "وَ قَلْبِيْ لَكُمْ مُسَلِّمٌ",
      "translation": ""
    },
    {
      "index": 271,
      "arabic": "وَ رَأْيِيْ لَكُمْ تَبَعٌ",
      "translation": ""
    },
    {
      "index": 272,
      "arabic": "وَ نُصْرَتِيْ لَكُمْ مُعَدَّةٌ",
      "translation": ""
    },
    {
      "index": 273,
      "arabic": "حَتّٰى يُحْيِيَ اللّٰهُ تَعَالٰى دِيْنَهُ بِكُمْ",
      "translation": ""
    },
    {
      "index": 274,
      "arabic": "وَ يَرُدَّكُمْ فِيۤ اَيَّامِهِ",
      "translation": ""
    },
    {
      "index": 275,
      "arabic": "وَ يُظْهِرَكُمْ لِعَدْلِهِ",
      "translation": ""
    },
    {
      "index": 276,
      "arabic": "وَ يُمَكِّنَكُمْ فِيۤ اَرْضِهِ",
      "translation": ""
    },
    {
      "index": 277,
      "arabic": "فَمَعَكُمْ مَعَكُمْ",
      "translation": ""
    },
    {
      "index": 278,
      "arabic": "لَا مَعَ غَيْرِكُمْ [عَدُوِّكُمْ‏]",
      "translation": ""
    },
    {
      "index": 279,
      "arabic": "اٰمَنْتُ بِكُمْ",
      "translation": ""
    },
    {
      "index": 280,
      "arabic": "وَ تَوَلَّيْتُ اٰخِرَكُمْ بِمَا تَوَلَّيْتُ بِهِ اَوَّلَكُمْ",
      "translation": ""
    },
    {
      "index": 281,
      "arabic": "وَ بَرِئْتُ اِلَى اللّٰهِ عَزَّ وَ جَلَّ",
      "translation": ""
    },
    {
      "index": 282,
      "arabic": "مِنْ اَعْدَاۤئِكُمْ",
      "translation": ""
    },
    {
      "index": 283,
      "arabic": "وَ مِنَ الْجِبْتِ وَ الطَّاغُوْتِ",
      "translation": ""
    },
    {
      "index": 284,
      "arabic": "وَ الشَّيَاطِيْنِ وَ حِزْبِهِمُ الظَّالِمِيْنَ لَكُمُ",
      "translation": ""
    },
    {
      "index": 285,
      "arabic": "الْجَاحِدِيْنَ لِحَقِّكُمْ",
      "translation": ""
    },
    {
      "index": 286,
      "arabic": "وَ الْمَارِقِيْنَ مِنْ وِلَايَتِكُمْ",
      "translation": ""
    },
    {
      "index": 287,
      "arabic": "وَ الْغَاصِبِيْنَ لِاِرْثِكُمُ",
      "translation": ""
    },
    {
      "index": 288,
      "arabic": "الشَّآكِّيْنَ فِيكُمُ",
      "translation": ""
    },
    {
      "index": 289,
      "arabic": "[وَ] الْمُنْحَرِفِيْنَ عَنْكُمْ",
      "translation": ""
    },
    {
      "index": 290,
      "arabic": "وَ مِنْ كُلِّ وَلِيْجَةٍ دُوْنَكُمْ",
      "translation": ""
    },
    {
      "index": 291,
      "arabic": "وَ كُلِّ مُطَاعٍ سِوَاكُمْ",
      "translation": ""
    },
    {
      "index": 292,
      "arabic": "وَ مِنَ الْاَئِمَّةِ الَّذِيْنَ يَدْعُوْنَ اِلَى النَّارِ",
      "translation": ""
    },
    {
      "index": 293,
      "arabic": "فَثَبَّتَنِيَ اللّٰهُ اَبَدًا مَا حَيِيْتُ",
      "translation": ""
    },
    {
      "index": 294,
      "arabic": "عَلٰى مُوَالَاتِكُمْ",
      "translation": ""
    },
    {
      "index": 295,
      "arabic": "وَ مَحَبَّتِكُمْ وَ دِيْنِكُمْ",
      "translation": ""
    },
    {
      "index": 296,
      "arabic": "وَ وَفَّقَنِيْ لِطَاعَتِكُمْ",
      "translation": ""
    },
    {
      "index": 297,
      "arabic": "وَ رَزَقَنِيْ شَفَاعَتَكُمْ",
      "translation": ""
    },
    {
      "index": 298,
      "arabic": "وَ جَعَلَنِيْ مِنْ خِيَارِ مَوَالِيْكُمُ",
      "translation": ""
    },
    {
      "index": 299,
      "arabic": "التَّابِعِيْنَ لِمَا دَعَوْتُمْ اِلَيْهِ",
      "translation": ""
    },
    {
      "index": 300,
      "arabic": "وَ جَعَلَنِيْ مِمَّنْ يَقْتَصُّ اٰثَارَكُمْ",
      "translation": ""
    },
    {
      "index": 301,
      "arabic": "وَ يَسْلُكُ سَبِيْلَكُمْ",
      "translation": ""
    },
    {
      "index": 302,
      "arabic": "وَ يَهْتَدِيْ بِهُدَاكُمْ",
      "translation": ""
    },
    {
      "index": 303,
      "arabic": "وَ يُحْشَرُ فِيْ زُمْرَتِكُمْ",
      "translation": ""
    },
    {
      "index": 304,
      "arabic": "وَ وَيَكِرُّ فِيْ رَجْعَتِكُمْ",
      "translation": ""
    },
    {
      "index": 305,
      "arabic": "وَ يُمَلَّكُ فِيْ دَوْلَتِكُمْ",
      "translation": ""
    },
    {
      "index": 306,
      "arabic": "وَ يُشَرَّفُ فِيْ عَافِيَتِكُمْ",
      "translation": ""
    },
    {
      "index": 307,
      "arabic": "وَ يُمَكَّنُ فِيۤ اَيَّامِكُمْ",
      "translation": ""
    },
    {
      "index": 308,
      "arabic": "وَ تَقِرُّ عَيْنُهُ غَدًا بِرُؤْيَتِكُمْ",
      "translation": ""
    },
    {
      "index": 309,
      "arabic": "بِاَبِيۤ اَنْتُمْ وَ اُمِّيْ",
      "translation": ""
    },
    {
      "index": 310,
      "arabic": "وَ نَفْسِيْ وَ اَهْلِيْ وَ مَالِيْ",
      "translation": ""
    },
    {
      "index": 311,
      "arabic": "مَنْ اَرَادَ اللّٰهَ بَدَاَ بِكُمْ",
      "translation": ""
    },
    {
      "index": 312,
      "arabic": "وَ مَنْ وَحَّدَهُ قَبِلَ عَنْكُمْ",
      "translation": ""
    },
    {
      "index": 313,
      "arabic": "وَ مَنْ قَصَدَهُ تَوَجَّهَ بِكُمْ",
      "translation": ""
    },
    {
      "index": 314,
      "arabic": "مَوَالِيَّ لَاۤ اُحْصِيْ ثَنَاۤءَكُمْ",
      "translation": ""
    },
    {
      "index": 315,
      "arabic": "وَ لَاۤ اَبْلُغُ مِنَ الْمَدْحِ كُنْهَكُمْ",
      "translation": ""
    },
    {
      "index": 316,
      "arabic": "وَ مِنَ الْوَصْفِ قَدْرَكُمْ",
      "translation": ""
    },
    {
      "index": 317,
      "arabic": "وَ اَنْتُمْ نُوْرُ الْاَخْيَارِ",
      "translation": ""
    },
    {
      "index": 318,
      "arabic": "وَ هُدَاةُ الْاَبْرَارِ",
      "translation": ""
    },
    {
      "index": 319,
      "arabic": "وَ حُجَجُ الْجَبَّارِ",
      "translation": ""
    },
    {
      "index": 320,
      "arabic": "بِكُمْ فَتَحَ اللّٰهُ",
      "translation": ""
    },
    {
      "index": 321,
      "arabic": "وَ بِكُمْ يَخْتِمُ [اللّٰهُ‏]",
      "translation": ""
    },
    {
      "index": 322,
      "arabic": "وَ بِكُمْ يُنَزِّلُ الْغَيْثَ",
      "translation": ""
    },
    {
      "index": 323,
      "arabic": "وَ بِكُمْ يُمْسِكُ السَّمَاۤءَ اَنْ تَقَعَ عَلَى الْاَرْضِ اِلَّا بِاِذْنِهِ",
      "translation": ""
    },
    {
      "index": 324,
      "arabic": "وَ بِكُمْ يُنَفِّسُ الْهَمَّ",
      "translation": ""
    },
    {
      "index": 325,
      "arabic": "وَ يَكْشِفُ الضُّرَّ",
      "translation": ""
    },
    {
      "index": 326,
      "arabic": "وَ عِنْدَكُمْ مَا نَزَلَتْ بِهِ رُسُلُهُ",
      "translation": ""
    },
    {
      "index": 327,
      "arabic": "وَ هَبَطَتْ بِهِ مَلَاۤئِكَتُهُ",
      "translation": ""
    },
    {
      "index": 328,
      "arabic": "وَ اِلٰى جَدِّكُمْ",
      "translation": ""
    },
    {
      "index": 329,
      "arabic": "وَ اِلٰى اَخِيْكَ",
      "translation": ""
    },
    {
      "index": 330,
      "arabic": "بُعِثَ الرُّوْحُ الْاَمِيْنُ",
      "translation": ""
    },
    {
      "index": 331,
      "arabic": "اٰتَاكُمُ اللّٰهُ مَا لَمْ يُؤْتِ اَحَدًا مِنَ الْعَالَمِيْنَ",
      "translation": ""
    },
    {
      "index": 332,
      "arabic": "طَأْطَاَ كُلُّ شَرِيْفٍ لِشَرَفِكُمْ",
      "translation": ""
    },
    {
      "index": 333,
      "arabic": "وَ بَخَعَ كُلُّ مُتَكَبِّرٍ لِطَاعَتِكُمْ",
      "translation": ""
    },
    {
      "index": 334,
      "arabic": "وَ خَضَعَ كُلُّ جَبَّارٍ لِفَضْلِكُمْ",
      "translation": ""
    },
    {
      "index": 335,
      "arabic": "وَ ذَلَّ كُلُّ شَيْ‏ءٍ لَكُمْ",
      "translation": ""
    },
    {
      "index": 336,
      "arabic": "وَ اَشْرَقَتِ الْاَرْضُ بِنُوْرِكُمْ",
      "translation": ""
    },
    {
      "index": 337,
      "arabic": "وَ فَازَ الْفَاۤئِزُوْنَ بِوِلَايَتِكُمْ",
      "translation": ""
    },
    {
      "index": 338,
      "arabic": "بِكُمْ يُسْلَكُ اِلَى الرِّضْوَانِ",
      "translation": ""
    },
    {
      "index": 339,
      "arabic": "وَ عَلٰى مَنْ جَحَدَ وِلَايَتَكُمْ غَضَبُ الرَّحْمٰنِ",
      "translation": ""
    },
    {
      "index": 340,
      "arabic": "بِاَبِيۤ اَنْتُمْ وَ اُمِّيْ",
      "translation": ""
    },
    {
      "index": 341,
      "arabic": "وَ نَفْسِيْ وَ اَهْلِيْ وَ مَالِيْ",
      "translation": ""
    },
    {
      "index": 342,
      "arabic": "ذِكْرُكُمْ فِيْ الذَّاكِرِيْنَ",
      "translation": ""
    },
    {
      "index": 343,
      "arabic": "وَ اَسْمَاۤؤُكُمْ فِي الْاَسْمَاۤءِ",
      "translation": ""
    },
    {
      "index": 344,
      "arabic": "وَ اَجْسَادُكُمْ فِي الْاَجْسَادِ",
      "translation": ""
    },
    {
      "index": 345,
      "arabic": "وَ اَرْوَاحُكُمْ فِي الْاَرْوَاحِ",
      "translation": ""
    },
    {
      "index": 346,
      "arabic": "وَ اَنْفُسُكُمْ فِي النُّفُوْسِ",
      "translation": ""
    },
    {
      "index": 347,
      "arabic": "وَ اٰثَارُكُمْ فِي الْاٰثَارِ",
      "translation": ""
    },
    {
      "index": 348,
      "arabic": "وَ قُبُوْرُكُمْ فِي الْقُبُوْرِ",
      "translation": ""
    },
    {
      "index": 349,
      "arabic": "فَمَاۤ اَحْلٰىۤ اَسْمَاۤءَكُمْ",
      "translation": ""
    },
    {
      "index": 350,
      "arabic": "وَ اَكْرَمَ اَنْفُسَكُمْ",
      "translation": ""
    },
    {
      "index": 351,
      "arabic": "وَ اَعْظَمَ شَأْنَكُمْ",
      "translation": ""
    },
    {
      "index": 352,
      "arabic": "وَ اَجَلَّ خَطَرَكُمْ",
      "translation": ""
    },
    {
      "index": 353,
      "arabic": "وَ اَوْفٰى عَهْدَكُمْ",
      "translation": ""
    },
    {
      "index": 354,
      "arabic": "وَ اَصْدَقَ وَعْدَكُمْ‏",
      "translation": ""
    },
    {
      "index": 355,
      "arabic": "كَلَامُكُمْ نُوْرٌ",
      "translation": ""
    },
    {
      "index": 356,
      "arabic": "وَ اَمْرُكُمْ رُشْدٌ",
      "translation": ""
    },
    {
      "index": 357,
      "arabic": "وَ وَصِيَّتُكُمُ التَّقْوٰى",
      "translation": ""
    },
    {
      "index": 358,
      "arabic": "وَ فِعْلُكُمُ الْخَيْرُ",
      "translation": ""
    },
    {
      "index": 359,
      "arabic": "وَ عَادَتُكُمُ الْاِحْسَانُ",
      "translation": ""
    },
    {
      "index": 360,
      "arabic": "وَ سَجِيَّتُكُمُ الْكَرَمُ",
      "translation": ""
    },
    {
      "index": 361,
      "arabic": "وَ شَأْنُكُمُ الْحَقُّ",
      "translation": ""
    },
    {
      "index": 362,
      "arabic": "وَ الصِّدْقُ وَ الرِّفْقُ",
      "translation": ""
    },
    {
      "index": 363,
      "arabic": "وَ قَوْلُكُمْ حُكْمٌ وَ حَتْمٌ",
      "translation": ""
    },
    {
      "index": 364,
      "arabic": "وَ رَأْيُكُمْ عِلْمٌ وَ حِلْمٌ وَ حَزْمٌ",
      "translation": ""
    },
    {
      "index": 365,
      "arabic": "اِنْ ذُكِرَ الْخَيْرُ كُنْتُمْ اَوَّلَهُ",
      "translation": ""
    },
    {
      "index": 366,
      "arabic": "وَ اَصْلَهُ وَ فَرْعَهُ",
      "translation": ""
    },
    {
      "index": 367,
      "arabic": "وَ مَعْدِنَهُ وَ مَأْوَاهُ وَ مُنْتَهَاهُ",
      "translation": ""
    },
    {
      "index": 368,
      "arabic": "بِاَبِيۤ اَنْتُمْ وَ اُمِّيْ وَ نَفْسِيْ",
      "translation": ""
    },
    {
      "index": 369,
      "arabic": "كَيْفَ اَصِفُ حُسْنَ ثَنَاۤئِكُمْ",
      "translation": ""
    },
    {
      "index": 370,
      "arabic": "وَ اُحْصِيْ جَمِيْلَ بَلَاۤئِكُمْ",
      "translation": ""
    },
    {
      "index": 371,
      "arabic": "وَ بِكُمْ اَخْرَجَنَا اللّٰهُ مِنَ الذُّلِّ",
      "translation": ""
    },
    {
      "index": 372,
      "arabic": "وَ فَرَّجَ عَنَّا غَمَرَاتِ الْكُرُوْبِ",
      "translation": ""
    },
    {
      "index": 373,
      "arabic": "وَ اَنْقَذَنَا مِنْ شَفَا جُرُفِ الْهَلَكَاتِ",
      "translation": ""
    },
    {
      "index": 374,
      "arabic": "وَ مِنَ النَّارِ",
      "translation": ""
    },
    {
      "index": 375,
      "arabic": "بِاَبِيۤ اَنْتُمْ وَ اُمِّيْ وَ نَفْسِيْ",
      "translation": ""
    },
    {
      "index": 376,
      "arabic": "بِمُوَالَاتِكُمْ عَلَّمَنَا اللّٰهُ مَعَالِمَ دِيْنِنَا",
      "translation": ""
    },
    {
      "index": 377,
      "arabic": "وَ اَصْلَحَ مَا كَانَ فَسَدَ مِنْ دُنْيَانَا",
      "translation": ""
    },
    {
      "index": 378,
      "arabic": "وَ بِمُوَالَاتِكُمْ تَمَّتِ الْكَلِمَةُ",
      "translation": ""
    },
    {
      "index": 379,
      "arabic": "وَ عَظُمَتِ النِّعْمَةُ",
      "translation": ""
    },
    {
      "index": 380,
      "arabic": "وَائْتَلَفَتِ الْفُرْقَةُ",
      "translation": ""
    },
    {
      "index": 381,
      "arabic": "وَ بِمُوَالَاتِكُمْ تُقْبَلُ الطَّاعَةُ الْمُفْتَرَضَةُ",
      "translation": ""
    },
    {
      "index": 382,
      "arabic": "وَ لَكُمُ الْمَوَدَّةُ الْوَاجِبَةُ",
      "translation": ""
    },
    {
      "index": 383,
      "arabic": "وَ الدَّرَجَاتُ الرَّفِيْعَةُ",
      "translation": ""
    },
    {
      "index": 384,
      "arabic": "وَ الْمَقَامُ الْمَحْمُوْدُ",
      "translation": ""
    },
    {
      "index": 385,
      "arabic": "وَ الْمَكَانُ [وَ الْمَقَامُ‏] الْمَعْلُوْمُ عِنْدَ اللّٰهِ عَزَّ وَ جَلَّ",
      "translation": ""
    },
    {
      "index": 386,
      "arabic": "وَ الْجَاهُ الْعَظِيْمُ",
      "translation": ""
    },
    {
      "index": 387,
      "arabic": "وَ الشَّأْنُ الْكَبِيْرُ",
      "translation": ""
    },
    {
      "index": 388,
      "arabic": "وَ الشَّفَاعَةُ الْمَقْبُوْلَةُ",
      "translation": ""
    },
    {
      "index": 389,
      "arabic": "رَبَّنَاۤ اٰمَنَّا بِمَاۤ اَنْزَلْتَ",
      "translation": ""
    },
    {
      "index": 390,
      "arabic": "وَ اتَّبَعْنَا الرَّسُوْلَ",
      "translation": ""
    },
    {
      "index": 391,
      "arabic": "فَاكْتُبْنَا مَعَ الشَّاهِدِيْنَ",
      "translation": ""
    },
    {
      "index": 392,
      "arabic": "رَبَّنَا لَا تُزِغْ قُلُوْبَنَا بَعْدَ اِذْ هَدَيْتَنَا",
      "translation": ""
    },
    {
      "index": 393,
      "arabic": "وَ هَبْ لَنَا مِنْ لَدُنْكَ رَحْمَةً",
      "translation": ""
    },
    {
      "index": 394,
      "arabic": "اِنَّكَ اَنْتَ الْوَهَّابُ",
      "translation": ""
    },
    {
      "index": 395,
      "arabic": "سُبْحَانَ رَبِّنَا",
      "translation": ""
    },
    {
      "index": 396,
      "arabic": "اِنْ كَانَ وَعْدُ رَبِّنَا لَمَفْعُوْلًا",
      "translation": ""
    },
    {
      "index": 397,
      "arabic": "يَا وَلِيَّ اللّٰهِ",
      "translation": ""
    },
    {
      "index": 398,
      "arabic": "اِنَّ بَيْنِيْ وَ بَيْنَ اللّٰهِ عَزَّ وَ جَلَّ ذُنُوْبًا",
      "translation": ""
    },
    {
      "index": 399,
      "arabic": "لَا يَأْتِيْ عَلَيْهَا اِلَّا رِضَاكُمْ",
      "translation": ""
    },
    {
      "index": 400,
      "arabic": "فَبِحَقِّ مَنِائْتَمَنَكُمْ عَلٰى سِرِّهِ",
      "translation": ""
    },
    {
      "index": 401,
      "arabic": "وَ اسْتَرْعَاكُمْ اَمْرَ خَلْقِهِ",
      "translation": ""
    },
    {
      "index": 402,
      "arabic": "وَ قَرَنَ طَاعَتَكُمْ بِطَاعَتِهِ",
      "translation": ""
    },
    {
      "index": 403,
      "arabic": "لَمَّا اسْتَوْهَبْتُمْ ذُنُوْبِيْ",
      "translation": ""
    },
    {
      "index": 404,
      "arabic": "وَ كُنْتُمْ شُفَعَاۤئِيْ",
      "translation": ""
    },
    {
      "index": 405,
      "arabic": "فَاِنِّيْ لَكُمْ مُطِيْعٌ",
      "translation": ""
    },
    {
      "index": 406,
      "arabic": "مَنْ اَطَاعَكُمْ فَقَدْ اَطَاعَ اللّٰهَ",
      "translation": ""
    },
    {
      "index": 407,
      "arabic": "وَ مَنْ عَصَاكُمْ فَقَدْ عَصَى اللّٰهَ",
      "translation": ""
    },
    {
      "index": 408,
      "arabic": "وَ مَنْ اَحَبَّكُمْ فَقَدْ اَحَبَّ اللّٰهَ",
      "translation": ""
    },
    {
      "index": 409,
      "arabic": "وَ مَنْ اَبْغَضَكُمْ فَقَدْ اَبْغَضَ اللّٰهَ",
      "translation": ""
    },
    {
      "index": 410,
      "arabic": "اَللّٰهُمَّ اِنِّيْ لَوْ وَجَدْتُ شُفَعَاۤءَ",
      "translation": ""
    },
    {
      "index": 411,
      "arabic": "اَقْرَبَ اِلَيْكَ مِنْ مُحَمَّدٍ وَ اَهْلِ بَيْتِهِ",
      "translation": ""
    },
    {
      "index": 412,
      "arabic": "الْاَخْيَارِ الْاَئِمَّةِ الْاَبْرَارِ",
      "translation": ""
    },
    {
      "index": 413,
      "arabic": "لَجَعَلْتُهُمْ شُفَعَاۤئِيْ",
      "translation": ""
    },
    {
      "index": 414,
      "arabic": "فَبِحَقِّهُمُ الَّذِيْۤ اَوْجَبْتَ لَهُمْ عَلَيْكَ",
      "translation": ""
    },
    {
      "index": 415,
      "arabic": "اَسْاَلُكَ اَنْ تُدْخِلَنِيْ فِيْ جُمْلَةِ الْعَارِفِيْنَ بِهِمْ وَ بِحَقِّهِمْ",
      "translation": ""
    },
    {
      "index": 416,
      "arabic": "وَ فِيْ زُمْرَةِ الْمَرْحُوْمِيْنَ بِشَفَاعَتِهِمْ",
      "translation": ""
    },
    {
      "index": 417,
      "arabic": "اِنَّكَ اَرْحَمُ الرَّاحِمِيْنَ",
      "translation": ""
    },
    {
      "index": 418,
      "arabic": "وَ صَلَّى اللّٰهُ عَلٰى مُحَمَّدٍ وَ اٰلِهِ الطَّاهِرِيْنَ",
      "translation": ""
    },
    {
      "index": 419,
      "arabic": "وَ سَلَّمَ تَسْلِيْمًا كَثِيْرًا",
      "translation": ""
    },
    {
      "index": 420,
      "arabic": "وَ حَسْبُنَا اللّٰهُ وَ نِعْمَ الْوَكِيْلُ۔",
      "translation": ""
    }
  ],
  "sourceUrl": "https://www.ya-mahdi.net/view.php?cat=maf_ziy132&lang=en"
}