    },
    {
      "index": 370,
      "arabic": "وَاجْعَلْنِىْ لَكَ مِنَ الْعَابِدِيْنَ",
      "translation": ""
    },
    {
      "index": 371,
      "arabic": "وَلِنَعْمَاۤئِكَ مِنَ الشَّاكِرِيْنَ،",
      "translation": ""
    },
    {
      "index": 372,
      "arabic": "وَلِٰالَاۤئِكَ مِنَ الذَّاكِرِيْنَ",
      "translation": ""
    },
    {
      "index": 373,
      "arabic": "وَارْحَمْنِىْ بِرَحْمَتِكَ",
      "translation": ""
    },
    {
      "index": 374,
      "arabic": "يَاۤ اَرْحَمَ الرَّاحِمِيْنَ",
      "translation": ""
    },
    {
      "index": 375,
      "arabic": "وَعِزَّتِكَ يَا كَرِيْمُ",
      "translation": ""
    },
    {
      "index": 376,
      "arabic": "لَاَطْلُبَنَّ مِمَّا لَدَيْكَ",
      "translation": ""
    },
    {
      "index": 377,
      "arabic": "وَلَاُلِحَّنَّ عَلَيْكَ",
      "translation": ""
    },
    {
      "index": 378,
      "arabic": "وَلَاَمُدَّنَّ يَدِىْ نَحْوَكَ",
      "translation": ""
    },
    {
      "index": 379,
      "arabic": "مَعَ جُرْمِهَا اِلَيْكَ",
      "translation": ""
    },
    {
      "index": 380,
      "arabic": "يَا رَبِّ فَبِمَنْ اَعُوْذُ",
      "translation": ""
    },
    {
      "index": 381,
      "arabic": "وَبِمَنْ اَلُوْذُ",
      "translation": ""
    },
    {
      "index": 382,
      "arabic": "لَاۤ اَجِدُ لِىْ اِلَّااَنْتَ",
      "translation": ""
    },
    {
      "index": 383,
      "arabic": "اَفَتَرُدُّنِىْ وَاَنْتَ مُعَوَّلِىْ",
      "translation": ""
    },
    {
      "index": 384,
      "arabic": "وَعَلَيْكَ مُتَّكَ لِىْ",
      "translation": ""
    },
    {
      "index": 385,
      "arabic": "اَسْئَلُكَ بِاسْمِكَ الَّذِىْ وَضَعْتَهُ عَلَى السَّمَاۤءِ فَاسْتَقَلَّتْ",
      "translation": ""
    },
    {
      "index": 386,
      "arabic": "وَعَلَى الْاَرْضِ فَاسْتَقَرَّتْ",
      "translation": ""
    },
    {
      "index": 387,
      "arabic": "وَعَلَى الْجِبَالِ فَرَسَتْ",
      "translation": ""
    },
    {
      "index": 388,
      "arabic": "وَعَلَى اللَّيْلِ فَاَظْلَمَ",
      "translation": ""
    },
    {
      "index": 389,
      "arabic": "وَعَلَى النَّهَارِ فَاسْتَنَارَ",
      "translation": ""
    },
    {
      "index": 390,
      "arabic": "اَنْ تُصَلِّىَ عَلٰى مُحَمَّدٍ وَاٰلِ مُحَمِّدٍ",
      "translation": ""
    },
    {
      "index": 391,
      "arabic": "وَاَنْ تَقْضِىَ لِىْ حَوَاۤئِجِىْ كُلَّهَا",
      "translation": ""
    },
    {
      "index": 392,
      "arabic": "وَتَغْفِرَ لِىْ ذُنُوْبِىْ كُلَّهَا",
      "translation": ""
    },
    {
      "index": 393,
      "arabic": "صَغِيْرَهَا وَكَبِيْرَهَا",
      "translation": ""
    },
    {
      "index": 394,
      "arabic": "وَتُوَسِّعَ عَلَىَّ مِنَ الرِّزْقِ",
      "translation": ""
    },
    {
      "index": 395,
      "arabic": "مَا تُبَلِّغُنِىْ بِهِ شَرَفَ الدُّنْيَا وَالْاٰخِرَةِ",
      "translation": ""
    },
    {
      "index": 396,
      "arabic": "يَا اَرْحَمَ الرَّاحِمِيْنَ۔",
      "translation": ""
    },
    {
      "index": 397,
      "arabic": "مَوْلَاىَ بِكَ اسْتَعَنْتُ",
      "translation": ""
    },
    {
      "index": 398,
      "arabic": "فَصَلِّ عَلٰى مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ وَاَعِنِّىْ",
      "translation": ""
    },
    {
      "index": 399,
      "arabic": "وَبِكَ اسْتَجَرْتُ فَاَجِرْنِىْ",
      "translation": ""
    },
    {
      "index": 400,
      "arabic": "وَاَغْنِنِىْ بِطَاعَتِكَ عَنْ طَاعَةِ عِبَادِكَ",
      "translation": ""
    },
    {
      "index": 401,
      "arabic": "وَبِمَسْئَلَتِكَ عَنْ مَسْئَلَةِ خَلْقِكَ",
      "translation": ""
    },
    {
      "index": 402,
      "arabic": "وَانْقُلْنِىْ مِنْ ذُلِّ الْفَقْرِ اِلٰى عِزِّ الْغِنٰى",
      "translation": ""
    },
    {
      "index": 403,
      "arabic": "وَمِنْ ذُلِّ الْمَعَاصِىْ اِلٰى عِزِّ الطَّاعَةِ",
      "translation": ""
    },
    {
      "index": 404,
      "arabic": "فَقَدْ فَضَّلْتَنِىْ عَلٰى كَثِيْرٍ مِنْ خَلْقِكَ",
      "translation": ""
    },
    {
      "index": 405,
      "arabic": "جُوْدًا مِنْكَ وَكَرَمًا",
      "translation": ""
    },
    {
      "index": 406,
      "arabic": "لَا بِاسْتِحْقَاقٍ مِنِّىْ",
      "translation": ""
    },
    {
      "index": 407,
      "arabic": "اِلٰهِىْ فَلَكَ الْحَمْدُ عَلٰى ذٰلِكَ كُلِّهِ",
      "translation": ""
    },
    {
      "index": 408,
      "arabic": "صَلِّ عَلٰى مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ",
      "translation": ""
    },
    {
      "index": 409,
      "arabic": "وَاجْعَلْنِىْ لِنَعْمَاۤئِكَ مِنَ الشَّاكِرِيْنَ",
      "translation": ""
    },
    {
      "index": 410,
      "arabic": "وَلِاٰلَاۤئِكَ مِنَ الذَّ اكِرِيْنَ۔",
      "translation": ""
    },
    {
      "index": 411,
      "arabic": "سَجَدَ وَجْهِىَ الذَّلِيْلُ",
      "translation": ""
    },
    {
      "index": 412,
      "arabic": "لِوَجْهِكَ الْعَزِيْزِ الْجَلِيْلِ",
      "translation": ""
    },
    {
      "index": 413,
      "arabic": "سَجَدَ وَجْهِىَ الْبَالِى الْفَانِىْ",
      "translation": ""
    },
    {
      "index": 414,
      "arabic": "لِوَجْهِكَ الدَّاۤئِمِ الْبَاقِىْ",
      "translation": ""
    },
    {
      "index": 415,
      "arabic": "سَجَدَ وَجْهِىَ الْفَقِيْرُ",
      "translation": ""
    },
    {
      "index": 416,
      "arabic": "لِوَجْهِكَ الْغَنِىِّ الْكَبِيْرِ",
      "translation": ""
    },
    {
      "index": 417,
      "arabic": "سَجَدَ وَجْهِىْ وَسَمْعِىْ وَبَصَرِىْ",
      "translation": ""
    },
    {
      "index": 418,
      "arabic": "وَلَحْمِىْ وَدَمِىْ وَجِلْدِىْ",
      "translation": ""
    },
    {
      "index": 419,
      "arabic": "وَعَظْمِىْ وَمَا اَقَلَّتِ الْاَرْضُ مِنِّى",
      "translation": ""
    },
    {
      "index": 420,
      "arabic": "لِلّٰهِ رَبِّ الْعَالَمِيْنَ",
      "translation": ""
    },
    {
      "index": 421,
      "arabic": "اَللّٰهُمَّ عُدْ عَلٰى جَهْلِىْ بِحِلْمِكَ",
      "translation": ""
    },
    {
      "index": 422,
      "arabic": "وَعَلٰى فَقْرِىْ بِغِنَاكَ",
      "translation": ""
    },
    {
      "index": 423,
      "arabic": "وَعَلٰى ذُلِّىْ بِعِزِّكَ وَسُلْطَانِكَ",
      "translation": ""
    },
    {
      "index": 424,
      "arabic": "وَعَلٰى ضَعْفِىْ بِقُوَّتِكَ",
      "translation": ""
    },
    {
      "index": 425,
      "arabic": "وَعَلٰى خَوْفِىْ بِاَمْنِكَ",
      "translation": ""
    },
    {
      "index": 426,
      "arabic": "وَعَلٰى ذُنُوْبِىْ وَخَطَايَاىَ بِعَفْوِكَ وَرَحْمَتِكَ",
      "translation": ""
    },
    {
      "index": 427,
      "arabic": "يَا رَحْمٰنُ يَا رَحِيْمُ۔",
      "translation": ""
    },
    {
      "index": 428,
      "arabic": "اَللّٰهُمَّ اِنِّىْ اَدْرَاُبِكَ فِى",
      "translation": ""
    },
    {
      "index": 429,
      "arabic": "نَحْرِ...",
      "translation": ""
    },
    {
      "index": 430,
      "arabic": "وَاَعُوُذُ بِكَ مِنْ شَرِّهِ",
      "translation": ""
    },
    {
      "index": 431,
      "arabic": "فَاكْفِنِيْهِ بِمَا كَفَيْتَ بِهِ اَنْبِيَاۤئَكَ",
      "translation": ""
    },
    {
      "index": 432,
      "arabic": "وَاَوْلِيَاۤئَكَ مِنْ خَلْقِكَ",
      "translation": ""
    },
    {
      "index": 433,
      "arabic": "وَصَالِحِىْ عِبَادِكَ",
      "translation": ""
    },
    {
      "index": 434,
      "arabic": "مِنْ فَرَاعِنَةِ خَلْقِكَ",
      "translation": ""
    },
    {
      "index": 435,
      "arabic": "وَطُغَاةِ عُدَاتِكَ",
      "translation": ""
    },
    {
      "index": 436,
      "arabic": "وَشَرِّ جَمِيْعِ خَلْقِكَ",
      "translation": ""
    },
    {
      "index": 437,
      "arabic": "بِرَحْمَتِكَ يَاۤ اَرْحَمَ الرَّاحِمِيْنَ",
      "translation": ""
    },
    {
      "index": 438,
      "arabic": "اِنَّكَ عَلٰى كُلِّ شَىْءٍ قَدِيْرٌ",
      "translation": ""
    },
    {
      "index": 439,
      "arabic": "وَحَسْبُنَا اللهُ وَنِعْمَ الْوَكِيْلُ۔",
      "translation": ""
    }
  ],
