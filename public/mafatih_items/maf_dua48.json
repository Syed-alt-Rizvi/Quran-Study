    },
    {
      "index": 26,
      "arabic": "فَلَكَ الْحَمْدُ يَا رَبِّ",
      "translation": ""
    },
    {
      "index": 27,
      "arabic": "مِنْ مُقْتَدِرٍ لَا يُغْلَبُ",
      "translation": ""
    },
    {
      "index": 28,
      "arabic": "وَذِىْ اَنَاةٍ لَا يَعْجَلُ",
