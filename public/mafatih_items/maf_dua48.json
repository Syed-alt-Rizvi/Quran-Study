      "index": 333,
      "arabic": "فَلَا يَدْرِىْ اَىُّ حَالٍ يُفْعَلُ بِهِ",
      "translation": ""
    },
    {
      "index": 334,
      "arabic": "وَاَىُّ مُثْلَةٍ يُمَثَّلُ بِهِ",
      "translation": ""
    },
    {
      "index": 335,
      "arabic": "فَهُوَ فِىْ ضُرٍّ مِنَ الْعَيْشِ",
      "translation": ""
    },
    {
      "index": 336,
      "arabic": "وَضَنْكٍ مِنَ الْحَيٰوةِ",
      "translation": ""
    },
    {
      "index": 337,
      "arabic": "يَنْظُرُ اِلٰى نَفْسِهِ حَسْرَةً",
      "translation": ""
    },
    {
      "index": 338,
      "arabic": "لَايَسْتَطِيْعُ لَهَا ضَرًّا وَلَا نَفْعًا",
      "translation": ""
    },
    {
      "index": 339,
      "arabic": "وَاَنَا خِلْوٌ مِنْ ذٰلِكَ كُلِّهِ",
      "translation": ""
    },
    {
      "index": 340,
      "arabic": "بِجُوْدِكَ وَكَرَمِكَ",
      "translation": ""
    },
    {
      "index": 341,
      "arabic": "فَلَاۤ اِلٰهَ اِلَّا اَنْتَ سُبْحَانَكَ",
      "translation": ""
    },
    {
      "index": 342,
      "arabic": "مِنْ مُقْتَدِرٍ لَا يُغْلَبُ",
      "translation": ""
    },
    {
      "index": 343,
      "arabic": "وَذِىْ اَنَاةٍ لَا يَعْجَلُ",
      "translation": ""
    },
    {
      "index": 344,
      "arabic": "صَلِّ عَلٰى مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ",
      "translation": ""
    },
    {
      "index": 345,
      "arabic": "وَاجْعَلْنِىْ لَكَ مِنَ الْعَابِدِيْنَ",
      "translation": ""
    },
    {
      "index": 346,
      "arabic": "ولِنَعْمَاۤئِكَ مِنَ الشَّاكِرِيْنَ",
      "translation": ""
    },
    {
      "index": 347,
      "arabic": "وَلِاٰلَاۤئِكَ مِنَ الذَّاكِرِيْنَ",
      "translation": ""
    },
    {
      "index": 348,
      "arabic": "وَارْحَمْنِىْ بِرَحْمَتِكَ",
      "translation": ""
    },
    {
      "index": 349,
      "arabic": "يَاۤ اَرْحَمَ الرَّاحِمِيْنَ۔",
      "translation": ""
    },
    {
      "index": 350,
      "arabic": "سَيِّدِىْ وَمَوْلَاىَ",
      "translation": ""
    },
    {
      "index": 351,
      "arabic": "وَكَمْ مِنْ عَبْدٍ اَمْسٰى وَاَصْبَحَ",
      "translation": ""
    },
    {
      "index": 352,
      "arabic": "قَدِ اسْتَمَرَّ عَلَيْهِ الْقَضَاۤءُ",
      "translation": ""
    },
    {
      "index": 353,
      "arabic": "وَاَحْدَقَ بِهِ الْبَلَاۤءُ",
      "translation": ""
    },
    {
      "index": 354,
      "arabic": "وَفَارَقَ اَوِدَّ اۤئَهُ وَاَحِبَّاۤئَهُ وَاَخِلَّاۤئَهُ",
      "translation": ""
    },
    {
      "index": 355,
      "arabic": "وَاَمْسٰى اَسِيْرًا حَقِيْرًا ذَلِيْلًا",
      "translation": ""
    },
    {
      "index": 356,
      "arabic": "فِىْ اَيْدِى الْكُفَّارِ وَالْاَعْدَاۤءِ",
      "translation": ""
    },
    {
      "index": 357,
      "arabic": "يَتَدَاوَلُوْنَهُ يَمِيْنًا وَشِمَالًا",
      "translation": ""
    },
    {
      "index": 358,
      "arabic": "قَدْ حُصِرَ فِى الْمَطَامِيْرِ",
      "translation": ""
    },
    {
      "index": 359,
      "arabic": "وَثُقِّلَ بِالْحَدِيْدِ",
      "translation": ""
    },
    {
      "index": 360,
      "arabic": "لَا يَرٰى شَيْئًا مِنْ ضِيَاۤءِ الدُّنْيَا",
      "translation": ""
    },
    {
      "index": 361,
      "arabic": "وَلَا مِنْ رَوْحِهَا",
      "translation": ""
    },
    {
      "index": 362,
      "arabic": "يَنْظُرُ اِلٰى نَفْسِهِ حَسْرَةً",
      "translation": ""
    },
    {
      "index": 363,
      "arabic": "لَا يَسْتَطِيْعُ لَهَا ضَرًّا وَلَا نَفْعًا",
      "translation": ""
    },
    {
      "index": 364,
      "arabic": "وَاَنَا خِلْوٌ مِنْ ذٰلِكَ كُلِّهِ",
