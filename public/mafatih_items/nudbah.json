    {
      "index": 105,
      "arabic": "اِلَّاۤ اَنَّهٗ لَا نَبِیَّ بَعْدِیْ",
      "translation": ""
    },
    {
      "index": 106,
      "arabic": "وَ زَوَّجَهٗ ابْنَتَهٗ سَیِّدَۃَ نِسَاۤءِ الْعَالَمِیْنَ",
      "translation": ""
    },
    {
      "index": 107,
      "arabic": "وَ اَحَلَّ لَهٗ مِنْ مَسْجِدِهٖ مَا حَلَّ لَهٗ",
      "translation": ""
    },
    {
      "index": 108,
      "arabic": "وَ سَدَّ الْاَبْوَابَ اِلَّا بَابَهٗ",
      "translation": ""
    },
    {
      "index": 109,
      "arabic": "ثُمَّ اَوْدَعَهٗ عِلْمَهٗ وَ حِكْمَتَهٗ",
      "translation": ""
    },
    {
      "index": 110,
      "arabic": "فَقَالَ اَنَا مَدِیْنَۃُ الْعِلْمِ وَ عَلِیٌّ بَابُھَا",
      "translation": ""
    },
    {
      "index": 111,
      "arabic": "فَمَنْ اَرَادَ الْمَدِیْنَۃَ وَ الْحِكْمَۃَ",
      "translation": ""
    },
    {
      "index": 112,
      "arabic": "فَلْیَاْتِھَا مِنْ بَابِھَا",
      "translation": ""
    },
    {
      "index": 113,
      "arabic": "ثُمَّ قَالَ اَنْتَ اَخِیْ وَ وَصِیِّیْ وَ وَارِثِیْ",
      "translation": ""
    },
    {
      "index": 114,
      "arabic": "لَحْمُكَ مِنْ لَحْمِیْ",
      "translation": ""
    },
    {
      "index": 115,
      "arabic": "وَ دَمُكَ مِنْ دَمِیْ",
      "translation": ""
    },
    {
      "index": 116,
      "arabic": "وَ سِلْمُكَ سِلْمِیْ",
      "translation": ""
    },
    {
      "index": 117,
      "arabic": "وَ حَرْبُكَ حَرْبِیْ",
      "translation": ""
    },
    {
      "index": 118,
      "arabic": "وَ الْاِیْمَانُ مُخَالِطٌ لَحْمَكَ وَ دَمَكَ",
      "translation": ""
    },
    {
      "index": 119,
      "arabic": "كَمَا خَالَطَ لَحْمِیْ وَدَمِیْ",
      "translation": ""
    },
    {
      "index": 120,
      "arabic": "وَ اَنْتَ غَدًا عَلَی الْحَوْضِ خَلِیْفَتِیْ",
      "translation": ""
    },
    {
      "index": 121,
      "arabic": "وَ اَنْتَ تَقْضِیْ دَیْنِیْ",
      "translation": ""
    },
    {
      "index": 122,
      "arabic": "وَ تُنْجِزُ عِدَاتِیْ",
      "translation": ""
    },
    {
      "index": 123,
      "arabic": "وَ شِیْعَتُكَ عَلٰی مَنَابِرَ مِنْ نُوْرٍ",
      "translation": ""
    },
    {
      "index": 124,
      "arabic": "مُبْیَضَّۃً وُجُوْھُھُمْ حَوْلِیْ فِی الْجَنَّۃِ",
      "translation": ""
    },
    {
      "index": 125,
      "arabic": "وَ ھُمْ جِیْرَانِیْ",
      "translation": ""
    },
    {
      "index": 126,
      "arabic": "وَ لَوْلَاۤ اَنْتَ یَا عَلِیُّ",
      "translation": ""
    },
    {
      "index": 127,
      "arabic": "لَمْ یُعْرَفِ الْمُؤْمِنُوْنَ بَعْدِیْ",
      "translation": ""
    },
    {
      "index": 128,
      "arabic": "وَ كَانَ بَعْدَهٗ ھُدًی مِنَ الضَّلَالِ",
      "translation": ""
    },
    {
      "index": 129,
      "arabic": "وَ نُوْرًا مِّنَ الْعَمٰی",
      "translation": ""
    },
    {
      "index": 130,
      "arabic": "وَ حَبْلَ ﷲِ الْمَتِیْنَ",
      "translation": ""
    },
    {
      "index": 131,
      "arabic": "وَ صِرَاطَهُ الْمُسْتَقِیْمَ",
      "translation": ""
    },
    {
      "index": 132,
      "arabic": "لَا یُسْبَقُ بِقَرَابَۃٍ فِیْ رَحِمٍ",
      "translation": ""
    },
    {
      "index": 133,
      "arabic": "وَ لَا بِسَابِقَۃٍ فِیْ دِیْنٍ",
      "translation": ""
    },
    {
      "index": 134,
      "arabic": "وَ لَا یُلْحَقُ فِیْ مَنْقَبَۃٍ مِنْ مَنَاقِبِهٖ",
      "translation": ""
    },
    {
      "index": 135,
      "arabic": "یَحْذُوْ حَذْوَ الرَّسُوْلِ",
      "translation": ""
    },
    {
      "index": 136,
      "arabic": "صَلَّی اﷲُ عَلَیْھِمَا وَ اٰلِھِمَا",
      "translation": ""
    },
    {
      "index": 137,
      "arabic": "وَ یُقَاتِلُ عَلَی التَّاْوِیْلِ",
      "translation": ""
    },
    {
      "index": 138,
      "arabic": "وَ لَا تَاخُذُهٗ فِی اﷲِ لَوْمَتُ لَاۤئِمٍ",
      "translation": ""
    },
    {
      "index": 139,
      "arabic": "قَدْ وَتَرَ فِیْهِ صَنَادِیْدَ الْعَرَبِ",
      "translation": ""
    },
    {
      "index": 140,
      "arabic": "وَ قَتَلَ اَبْطَالَھُمْ",
      "translation": ""
    },
    {
      "index": 141,
      "arabic": "وَ نَاوَشَ ذُؤْبَانَھُمْ",
      "translation": ""
    },
    {
      "index": 142,
      "arabic": "فَاَوْدَعَ قُلُوْبَھُمْ اَحْقَادًا",
      "translation": ""
    },
    {
      "index": 143,
      "arabic": "بَدْرِیَّۃً وَّ خَیْبَرِیَّۃً وَّ حُنَیْنِیَّۃً وَ غَیْرَ ھُنَّ",
      "translation": ""
    },
    {
      "index": 144,
      "arabic": "فَاَضَبَّتْ عَلٰی عَدَاوَتِهٖ",
      "translation": ""
    },
    {
      "index": 145,
      "arabic": "وَ اَكَبَّتْ عَلٰی مُنَابَذَتِهٖ",
      "translation": ""
    },
    {
      "index": 146,
      "arabic": "حَتّٰی قَتَلَ النَّاكِثِیْنَ وَ الْقَاسِطِیْنَ وَ الْمَارِقِیْنَ",
      "translation": ""
    },
    {
      "index": 147,
      "arabic": "وَ لَمَّا قَضٰی نَحْبَهٗ",
      "translation": ""
    },
    {
      "index": 148,
      "arabic": "وَ قَتَلَهٗ اَشْقَی الْاٰخِرِیْنَ یَتْبَعُ اَشْقَی الْاَوَّلِیْنَ",
      "translation": ""
    },
    {
      "index": 149,
      "arabic": "لَمْ یُمْتَثَلْ اَمْرُ رَسُوْلِ اﷲِ",
      "translation": ""
    },
    {
      "index": 150,
      "arabic": "صَلَّی اﷲُ عَلَیْهِ وَ اٰلِهٖ",
      "translation": ""
    },
    {
      "index": 151,
      "arabic": "فِی الْھَادِیْنَ بَعْدَ الْھَادِیْنَ",
      "translation": ""
    },
    {
      "index": 152,
      "arabic": "وَ الْاُمَّۃُ مُصِرَّۃٌ عَلٰی مَقْتِهٖ",
      "translation": ""
    },
    {
      "index": 153,
      "arabic": "مُجْتَمِعَۃٌ عَلٰی قَطِیْعَۃِ رَحِمِهٖ",
      "translation": ""
    },
    {
      "index": 154,
      "arabic": "وَاِقْصَاءِ وُلْدِهٖ",
      "translation": ""
    },
    {
      "index": 155,
      "arabic": "اِلَّا الْقَلِیْلَ مِمَّنْ وَفٰی لِرِعَایَۃِ الْحَقِّ فِیْھِمْ",
      "translation": ""
    },
    {
      "index": 156,
      "arabic": "فَقُتِلَ مَنْ قُتِلَ",
      "translation": ""
    },
    {
      "index": 157,
      "arabic": "وَ سُبِیَ مَنْ سُبِیَ",
      "translation": ""
    },
    {
      "index": 158,
      "arabic": "وَ اُقْصِیَ مَنْ اُقْصِیَ",
      "translation": ""
    },
    {
      "index": 159,
      "arabic": "وَ جَرَی الْقَضَاۤءُ لَھُمْ",
      "translation": ""
    },
    {
      "index": 160,
      "arabic": "بِمَا یُرْجٰی لَهٗ حُسْنُ الْمَثُوْبَۃِ",
      "translation": ""
    },
    {
      "index": 161,
      "arabic": "اِذْ كَانَتِ الْاَرْضُ لِلّٰهِ",
      "translation": ""
    },
    {
      "index": 162,
      "arabic": "یُوْرِثُھَا مَنْ یَشَاۤءُ مِنْ عِبَادِهٖ",
      "translation": ""
    },
    {
      "index": 163,
      "arabic": "وَ الْعَاقِبَۃُ لِلْمُتَّقِیْنَ",
      "translation": ""
    },
    {
      "index": 164,
      "arabic": "وَ سُبْحَانَ رَبِّنَاۤ",
      "translation": ""
    },
    {
      "index": 165,
      "arabic": "اِنْ كَانَ وَعْدُ رَبِّنَا لَمَفْعُوْلًا",
      "translation": ""
    },
    {
      "index": 166,
      "arabic": "وَ لَنْ یُّخْلِفَ اﷲُ وَعْدَهٗ",
      "translation": ""
    },
    {
      "index": 167,
      "arabic": "وَ ھُوَ الْعَزِیْزُ الْحَكِیْمُ",
      "translation": ""
    },
    {
      "index": 168,
      "arabic": "فَعَلَی الْاَطَاۤئِبِ مِنْ اَھْلِ بَیْتِ مُحَمَّدٍ وَ عَلِیٍّ",
      "translation": ""
    },
    {
      "index": 169,
      "arabic": "صَلَّی اﷲُ عَلَیْھِمَا وَ اٰلِھِمَا",
      "translation": ""
    },
    {
      "index": 170,
      "arabic": "فَلْیَبْكِ الْبَاكُوْنَ",
      "translation": ""
    },
    {
      "index": 171,
      "arabic": "وَ اِیَّاھُمْ فَلْیَنْدُبِ النَّادِبُوْنَ",
      "translation": ""
    },
    {
      "index": 172,
      "arabic": "وَ لِمِثْلِھِمْ فَلْتَذْرِفِ الدُّمُوْعُ",
      "translation": ""
    },
    {
      "index": 173,
      "arabic": "وَ الْیَصْرُخِ الصَّارِخُوْنَ",
      "translation": ""
    },
    {
      "index": 174,
      "arabic": "وَ یَضِجَّ الضَّآجُّوْنَ",
      "translation": ""
    },
    {
      "index": 175,
      "arabic": "وَ یَعِجَّ الْعَآجُّوْنَ",
      "translation": ""
    },
    {
      "index": 176,
      "arabic": "اَیْنَ الْحَسَنُ اَیْنَ الْحُسَیْنُ",
      "translation": ""
    },
    {
      "index": 177,
      "arabic": "اَیْنَ اَبْنَاۤءُ الْحُسَیْنِ",
      "translation": ""
    },
    {
      "index": 178,
      "arabic": "صَالِحٌ بَعْدَ صَالِحٍ",
      "translation": ""
    },
    {
      "index": 179,
      "arabic": "وَ صَادِقٌ بَعْدَ صَادِقٍ",
      "translation": ""
    },
    {
      "index": 180,
      "arabic": "اَیْنَ السَّبِیْلُ بَعْدَ السَّبِیْلِ",
      "translation": ""
    },
    {
      "index": 181,
      "arabic": "اَیْنَ الْخِیَرَۃُ بَعْدَ الْخِیَرَۃِ",
      "translation": ""
    },
    {
      "index": 182,
      "arabic": "اَیْنَ الشُّمُوْسُ الطَّالِعَۃُ",
      "translation": ""
    },
    {
      "index": 183,
      "arabic": "اَیْنَ الْاَقْمَارُ الْمُنِیْرَۃُ",
      "translation": ""
    },
    {
      "index": 184,
      "arabic": "اَیْنَ الْاَنْجُمُ الزَّاھِرَۃُ",
      "translation": ""
    },
    {
      "index": 185,
      "arabic": "اَیْنَ اَعْلَامُ الدِّیْنِ",
      "translation": ""
    },
    {
      "index": 186,
      "arabic": "وَ قَوَاعِدُ الْعِلْمِ",
      "translation": ""
    },
    {
      "index": 187,
      "arabic": "اَیْنَ بَقِیَّۃُ اﷲِ",
      "translation": ""
    },
    {
      "index": 188,
      "arabic": "الَّتِیْ لَا تَخْلُوْ مِنَ الْعِتْرَۃِ الْھَادِیَۃِ",
      "translation": ""
    },
    {
      "index": 189,
      "arabic": "اَیْنَ الْمُعَدُّ لِقَطْعِ دَابِرِ الظَّلَمَۃِ",
      "translation": ""
    },
    {
      "index": 190,
      "arabic": "اَیْنَ الْمُنْتَظَرُ لِاِقَامَۃِ الْاَمْتِ وَ الْعِوَجِ",
      "translation": ""
    },
    {
      "index": 191,
      "arabic": "اَیْنَ الْمُرْتَجٰی لِاِزَالَۃِ الْجَوْرِ وَ الْعُدْوَانِ",
      "translation": ""
    },
    {
      "index": 192,
      "arabic": "اَیْنَ الْمُدَّخَرُ لِتَجْدِیْدِ الْفَرَاۤئِضِ وَالسُّنَنِ",
      "translation": ""
    },
    {
      "index": 193,
      "arabic": "اَیْنَ الْمُتَخَیَّرُ لِاِعَادَۃِ الْمِلَّۃِ وَ الشَّرِیْعَۃِ",
      "translation": ""
    },
    {
      "index": 194,
      "arabic": "اَیْنَ الْمُؤَمَّلُ لِاِحْیَاۤءِ الْكِتَابِ وَ حُدُوْدِهٖ",
      "translation": ""
    },
    {
      "index": 195,
      "arabic": "اَیْنَ مُحْیِیْ مَعَالِمِ الدِّیْنِ وَ اَھْلِهٖ",
      "translation": ""
    },
    {
      "index": 196,
      "arabic": "اَیْنَ قَاصِمُ شَوْكَۃِ الْمُعْتَدِیْنَ",
      "translation": ""
    },
    {
      "index": 197,
      "arabic": "اَیْنَ ھَادِمُ اَبْنِیَۃِ الشِّرْكِ وَ النِّفَاقِ",
      "translation": ""
    },
    {
      "index": 198,
      "arabic": "اَیْنَ مُبِیْدُ اَھْلِ الْفُسُوْقِ",
      "translation": ""
    },
    {
      "index": 199,
      "arabic": "وَ الْعِصْیَانِ وَ الطُّغْیَانِ",
      "translation": ""
    },
    {
      "index": 200,
      "arabic": "اَیْنَ حَاصِدُ فُرُوْعِ الْغَیِّ وَ الشِّقَاقِ",
      "translation": ""
    },
    {
      "index": 201,
      "arabic": "اَیْنَ طَامِسُ اٰثَارِ الزَّیْغِ وَ الْاَھْوَاۤءِ",
      "translation": ""
    },
    {
      "index": 202,
      "arabic": "اَیْنَ قَاطِعُ حَبَاۤئِلِ الْكِذْبِ وَ الْاِفْتِرَاۤءِ",
      "translation": ""
    },
    {
      "index": 203,
      "arabic": "اَیْنَ مُبِیْدُ الْعُتَاۃِ وَ الْمَرَدَۃِ",
      "translation": ""
    },
    {
      "index": 204,
      "arabic": "اَیْنَ مُسْتَاْصِلُ اَھْلِ الْعِنَادِ وَ التَّضْلِیْلِ وَالْاِلْحَادِ",
      "translation": ""
    },
    {
      "index": 205,
      "arabic": "اَیْنَ مُعِزُّ الْاَوْلِیَاۤءِ وَ مُذِلُّ الْاَعْدَاۤءِ",
      "translation": ""
    },
    {
      "index": 206,
      "arabic": "اَیْنَ جَامِعُ الْكَلِمَۃِ عَلَی التَّقْوٰی",
      "translation": ""
    },
    {
      "index": 207,
      "arabic": "اَیْنَ بَابُ اﷲِ الَّذِیْ مِنْهُ یُؤْتٰی",
      "translation": ""
    },
    {
      "index": 208,
      "arabic": "اَیْنَ وَجْهُ اﷲِ الَّذِیۤ اِلَیْهِ یَتَوَجَّهُ الْاَوْلِیَاۤءُ",
      "translation": ""
    },
    {
      "index": 209,
      "arabic": "اَیْنَ السَّبَبُ الْمُتَّصِلُ بَیْنَ الْاَرْضِ وَ السَّمَاۤءِ",
      "translation": ""
    },
    {
      "index": 210,
      "arabic": "اَیْنَ صَاحِبُ یَوْمِ الْفَتْحِ",
      "translation": ""
    },
    {
      "index": 211,
      "arabic": "وَ نَاشِرُ رَایَۃِ الْھُدٰی",
      "translation": ""
    },
    {
      "index": 212,
      "arabic": "اَیْنَ مُؤَلِّفُ شَمْلِ الصَّلَاحِ وَ الرِّضَاۤ",
      "translation": ""
    },
    {
      "index": 213,
      "arabic": "اَیْنَ الطَّالِبُ بِذُحُوْلِ الْاَنْبِیَاۤءِ وَ اَبْنَاۤءِ الْاَنْبِیَاۤءِ",
      "translation": ""
    },
    {
      "index": 214,
      "arabic": "اَیْنَ الطَّالِبُ بِدَمِ الْمَقْتُوْلِ بِكَرْبَلَاۤءَ",
      "translation": ""
    },
    {
      "index": 215,
      "arabic": "اَیْنَ الْمَنْصُوْرُ عَلٰی مَنِ اعْتَدٰی عَلَیْهِ وَافْتَرٰیۤ",
      "translation": ""
    },
    {
      "index": 216,
      "arabic": "اَیْنَ الْمُضْطَرُّ الَّذِیْ یُجَابُ اِذَا دَعَاۤ",
      "translation": ""
    },
    {
      "index": 217,
      "arabic": "اَیْنَ صَدْرُ الْخَلَاۤئِقِ ذُوالْبِرِّ وَ التَّقْوٰیۤ",
      "translation": ""
    },
    {
      "index": 218,
      "arabic": "اَیْنَ ابْنُ النَّبِیِّ الْمُصْطَفٰی",
      "translation": ""
    },
    {
      "index": 219,
      "arabic": "وَابْنُ عَلِیِّ نِ الْمُرْتَضٰی",
      "translation": ""
    },
    {
      "index": 220,
      "arabic": "وَ ابْنُ خَدِیْجَۃَ الْغَرَّاۤءِ",
      "translation": ""
    },
    {
      "index": 221,
      "arabic": "وَابْنُ فَاطِمَۃَ الْكُبْرٰی",
      "translation": ""
    },
    {
      "index": 222,
      "arabic": "بِاَبِیۤ اَنْتَ وَ اُمِّیْ",
      "translation": ""
    },
    {
      "index": 223,
      "arabic": "وَ نَفْسِیْ لَكَ الْوِقَاۤءُ وَ الْحِمٰی",
      "translation": ""
    },
    {
      "index": 224,
      "arabic": "یَابْنَ السَّادَۃِ الْمُقَرَّبِیْنَ",
      "translation": ""
    },
    {
      "index": 225,
      "arabic": "یَابْنَ النُّجَبَاۤءِ الْاَكْرِمِیْنَ",
      "translation": ""
    },
    {
      "index": 226,
      "arabic": "یَابْنَ الْھُدَاۃِ الْمَھْدِیِّیْنَ",
      "translation": ""
    },
    {
      "index": 227,
      "arabic": "یَابْنَ الْخِیَرَۃِ الْمُھَذَّبِیْنَ",
      "translation": ""
    },
    {
      "index": 228,
      "arabic": "یَابْنَ الْغَطَارِفَۃِ الْاَنْجَبِیْنَ",
      "translation": ""
    },
    {
      "index": 229,
      "arabic": "یَابْنَ الْاَطَاۤئِبِ الْمُطَھَّرِیْنَ",
      "translation": ""
    },
    {
      "index": 230,
      "arabic": "یَابْنَ الْخَضَارِمَۃِ الْمُنْتَجَبِیْنَ",
      "translation": ""
    },
    {
      "index": 231,
      "arabic": "یَابْنَ الْقَمَاقِمَۃِ الْاَكْرَمِیْنَ",
      "translation": ""
    },
    {
      "index": 232,
      "arabic": "یَابْنَ الْبُدُوْرِ الْمُنِیْرَۃٍ",
      "translation": ""
    },
    {
      "index": 233,
      "arabic": "یَابْنَ السُّرُجِ الْمُضِیۤئَۃِ",
      "translation": ""
    },
    {
      "index": 234,
      "arabic": "یَابْنَ الشُّھُبِ الثَّاقِبَۃِ",
      "translation": ""
    },
    {
      "index": 235,
      "arabic": "یَابْنَ الْاَنْجُمِ الزَّاھِرَۃِ",
      "translation": ""
    },
    {
      "index": 236,
      "arabic": "یَابْنَ السُّبُلِ الْوَاضِحَۃِ",
      "translation": ""
    },
    {
      "index": 237,
      "arabic": "یَابْنَ الْاَعْلَامِ الْلَاۤئِحَۃِ",
      "translation": ""
    },
    {
      "index": 238,
      "arabic": "یَابْنَ الْعُلُوْمِ الْكَامِلَۃِ",
      "translation": ""
    },
    {
      "index": 239,
      "arabic": "یَابْنَ السُّنَنِ الْمَشْھُوْرَۃِ",
      "translation": ""
    },
    {
      "index": 240,
      "arabic": "یَابْنَ الْمَعَالِمِ الْمَاْثُوْرَۃِ",
      "translation": ""
    },
    {
      "index": 241,
      "arabic": "یَابْنَ الْمُعْجِزَاتِ الْمَوْجُوْدَۃِ",
      "translation": ""
    },
    {
      "index": 242,
      "arabic": "یَابْنَ الدَّلَاۤئِلِ الْمَشْھُوْدَۃِ",
      "translation": ""
    },
    {
      "index": 243,
      "arabic": "یَابْنَ الصِّرَاطِ الْمُسْتَقِیْمِ",
      "translation": ""
    },
    {
      "index": 244,
      "arabic": "یَابْنَ النَّبَاۤءِ الْعَظِیْمِ",
      "translation": ""
    },
    {
      "index": 245,
      "arabic": "یَابْنَ مَنْ ھُوَ فِیۤ اُمِّ الْكِتَابِ لَدَی اﷲِ عَلِیٌّ حَكِیْمٌ",
      "translation": ""
    },
    {
      "index": 246,
      "arabic": "یَابْنَ الْاٰیَاتِ وَ البَیِّنَاتِ",
      "translation": ""
    },
    {
      "index": 247,
      "arabic": "یَابْنَ الدَّلَاۤئِلِ الظَّاھِرَاتِ",
      "translation": ""
    },
    {
      "index": 248,
      "arabic": "یَابْنَ الْبَرَاھِیْنِ الْوَاضِحَاتِ الْبَاھِرَاتِ",
      "translation": ""
    },
    {
      "index": 249,
      "arabic": "یَابْنَ الْحُجَجِ الْبَالِغَاتِ",
      "translation": ""
    },
    {
      "index": 250,
      "arabic": "یَابْنَ النِّعَمِ السَّابِغَاتِ",
      "translation": ""
    },
    {
      "index": 251,
      "arabic": "یَابْنَ طٰهٰ وَ الْمُحْكَمَاتِ",
      "translation": ""
    },
    {
      "index": 252,
      "arabic": "یَابْنَ یٰسٓ وَ الذَّارِیَاتِ",
      "translation": ""
    },
    {
      "index": 253,
      "arabic": "یَابْنَ الطُّوْرِ وَ الْعَادِیَاتِ",
      "translation": ""
    },
    {
      "index": 254,
      "arabic": "یَابْنَ مَنْ دَنٰی فَتَدَلّٰی",
      "translation": ""
    },
    {
      "index": 255,
      "arabic": "فَكَانَ قَابَ قَوْسَیْنِ اَوْ اَدْنٰی",
      "translation": ""
    },
    {
      "index": 256,
      "arabic": "دُنُوًّا وَ اقْتِرَابًا مِنَ الْعَلِیِّ الْاَعْلٰی",
      "translation": ""
    },
    {
      "index": 257,
      "arabic": "لَیْتَ شِعْرِیۤ اَیْنَ اسْتَقَرَّتْ بِكَ النَّوٰی",
      "translation": ""
    },
    {
      "index": 258,
      "arabic": "بَلْ اَیُّ اَرْضٍ تُقِلُّكَ اَوْ ثَرٰیۤ",
      "translation": ""
    },
    {
      "index": 259,
      "arabic": "اَبِرَضْوٰیۤ اَوْ غَیْرِھَاۤ اَمْ ذِیْ طُوٰی",
      "translation": ""
    },
    {
      "index": 260,
      "arabic": "عَزِیْزٌ عَلَیَّ اَنْ اَرَی الْخَلْقَ وَ لَا تُرَی",
      "translation": ""
    },
    {
      "index": 261,
      "arabic": "وَ لَاۤ اَسْمَعُ لَكَ حَسِیْسًا وَ لَا نَجْوٰی",
      "translation": ""
    },
    {
      "index": 262,
      "arabic": "عَزِیْزٌ عَلَیَّ اَنْ تُحِیْطَ بِكَ دُوْنَیِ الْبَلْوٰی",
      "translation": ""
    },
    {
      "index": 263,
      "arabic": "وَلَا یَنَالُكَ مِنِّیْ ضَجِیْجٌ وَلَا شَكْوٰی",
      "translation": ""
    },
    {
      "index": 264,
      "arabic": "بِنَفْسِیۤ اَنْتَ مِنْ مُغَیَّبٍ لَمْ یَخْلُ مِنَّا",
      "translation": ""
    },
    {
      "index": 265,
      "arabic": "بِنَفْسِیۤ اَنْتَ مِنْ نَازِحٍ مَا نَزَحَ عَنَّا",
      "translation": ""
    },
    {
      "index": 266,
      "arabic": "بِنَفْسِیۤ اَنْتَ اُمْنِیَّۃُ شَاۤئِقٍ یَتَمَنّٰی",
      "translation": ""
    },
    {
      "index": 267,
      "arabic": "مِنْ مُؤْمِنٍ وَ مُؤْمِنَۃٍ ذَكَرٰی فَحَنَّا",
      "translation": ""
    },
    {
      "index": 268,
      "arabic": "بِنَفْسِیۤ اَنْتَ مِنْ عَقِیْدِ عِزٍّ لَا یُسَامٰی",
      "translation": ""
    },
    {
      "index": 269,
      "arabic": "بِنَفْسِیۤ اَنْتَ مِنْ اَثِیْلِ مَجْدٍ لَا یُجَارٰی",
      "translation": ""
    },
    {
      "index": 270,
      "arabic": "بِنَفْسِیۤ اَنْتَ مِنْ تِلَادِ نِعَمٍ لَا تُضَاھٰی",
      "translation": ""
    },
    {
      "index": 271,
      "arabic": "بِنَفْسِیۤ اَنْتَ مِنْ نَصِیْفِ شَرَفٍ لَا یُسَاوٰی",
      "translation": ""
    },
    {
      "index": 272,
      "arabic": "اِلٰی مَتٰی اَحَارُ فِیْكَ یَا مَوْلَايَ وَ اِلٰی مَتٰی",
      "translation": ""
    },
    {
      "index": 273,
      "arabic": "وَ اَیَّ خِطَابٍ اَصِفُ فِیْكَ وَ اَیَّ نَجْوٰی",
      "translation": ""
    },
    {
      "index": 274,
      "arabic": "عَزِیْزٌ عَلَیَّ اَنْ اُجَابَ دُوْنَكَ وَ اُنَاغٰی",
      "translation": ""
    },
    {
      "index": 275,
      "arabic": "عَزِیْزٌ عَلَیَّ اَنْ اَبْكِیَكَ وَ یَخْذُلَكَ الْوَرٰی",
      "translation": ""
    },
    {
      "index": 276,
      "arabic": "عَزِیْزٌ عَلَیَّ اَنْ یَجْرِیَ عَلَیْكَ دُوْنَھُمْ مَاجَرٰی",
      "translation": ""
    },
    {
      "index": 277,
      "arabic": "ھَلْ مِنْ مُعِیْنٍ فَاُطِیْلَ مَعَهُ الْعَوِیْلَ وَ الْبُكَاۤءَ",
      "translation": ""
    },
    {
      "index": 278,
      "arabic": "ھَلْ مِنْ جَزُوْعٍ فَاُسَاعِدَ جَزَعَهٗ اِذَا خَلَا",
      "translation": ""
    },
    {
      "index": 279,
      "arabic": "ھَلْ قَذِیَتْ عَیْنٌ فَسَاعَدَتْھَا عَیْنِیْ عَلَی الْقَذٰی",
      "translation": ""
    },
    {
      "index": 280,
      "arabic": "ھَلْ اِلَیْكَ یَابْنَ اَحْمَدَ سَبِیْلٌ فَتُلْقٰی",
      "translation": ""
    },
    {
      "index": 281,
      "arabic": "ھَلْ یَتَّصِلُ یَوْمُنَا مِنْكَ بِعِدَۃِ فَنَحْظٰی",
      "translation": ""
    },
    {
      "index": 282,
      "arabic": "مَتٰی نَرِدُ مَنَاھِلَكَ الرَّوِیَّۃَ فَنَرْوٰی",
      "translation": ""
    },
    {
      "index": 283,
      "arabic": "مَتٰی نَنْتَقِعُ مِنْ عَذْبِ مَاۤئِكَ",
      "translation": ""
    },
    {
      "index": 284,
      "arabic": "فَقَدْ طَالَ الصَّدٰی",
      "translation": ""
    },
    {
      "index": 285,
      "arabic": "مَتٰی نُغَادِیْكَ وَ نُرَاوِحُكَ فَنُقِرُّ عَیْنًا",
      "translation": ""
    },
    {
      "index": 286,
      "arabic": "مَتٰی تَرَانَا وَ نَرَاكَ وَ قَدْ نَشَرْتَ لِوَاۤءَالنَّصْرِ تُرٰی",
      "translation": ""
    },
    {
      "index": 287,
      "arabic": "اَتَرَانَا نَحُفُّ بِكَ وَ اَنْتَ تَاُمُّ الْمَلَاَ",
      "translation": ""
    },
    {
      "index": 288,
      "arabic": "وَ قَدْ مَلَاْتَ الْاَرْضَ عَدْلًا",
      "translation": ""
    },
    {
      "index": 289,
      "arabic": "وَ اَذَقْتَ اَعْدَاۤئَكَ ھَوَانًا وَ عِقَابًا",
      "translation": ""
    },
    {
      "index": 290,
      "arabic": "وَ اَبَرْتَ الْعُتَاۃَ وَ جَحَدَۃِ الْحَقِّ",
      "translation": ""
    },
    {
      "index": 291,
      "arabic": "وَ قَطَعْتَ دَابِرَ الْمُتَكَبِّرِیْنَ",
      "translation": ""
    },
    {
      "index": 292,
      "arabic": "وَ اجْتَثَثْتَ اُصُوْلَ الظَّالِمِیْنَ",
      "translation": ""
    },
    {
      "index": 293,
      "arabic": "وَ نَحْنُ نَقُوْلُ الْحَمْدُ لِلّٰهِ رَبِّ الْعَالَمِیْنَ",
      "translation": ""
    },
    {
      "index": 294,
      "arabic": "اَللّٰھُمَّ اَنْتَ كَشَّافُ الْكُرَبِ وَ الْبَلْوٰی",
      "translation": ""
    },
    {
      "index": 295,
      "arabic": "وَ اِلَیْكَ اَسْتَعْدِیْ فَعِنْدَكَ الْعَدْوٰی",
      "translation": ""
    },
    {
      "index": 296,
      "arabic": "وَ اَنْتَ رَبُّ الْاٰخِرَۃِ وَ الدُّنْیَا",
      "translation": ""
    },
    {
      "index": 297,
      "arabic": "فَاَغِثْ یَا غِیَاثَ الْمُسْتَغِیْثِیْنَ عُبَیْدَكَ الْمُبْتَلٰی",
      "translation": ""
    },
    {
      "index": 298,
      "arabic": "وَ اَرِهٖ سَیِّدَهٗ یَا شَدِیْدَ الْقُوٰی",
      "translation": ""
    },
    {
      "index": 299,
      "arabic": "وَاَزِلْ عَنْهُ بِهِ الْاَسٰی وَ الْجَوٰی",
      "translation": ""
    },
    {
      "index": 300,
      "arabic": "وَ بَرِّدْ غَلِیْلَهٗ یَا مَنْ عَلَی الْعَرْشِ اسْتَوٰی",
      "translation": ""
    },
    {
      "index": 301,
      "arabic": "وَ مَنْ اِلَیْهِ الرُّجْعٰی وَالْمُنْتَھٰی",
      "translation": ""
    },
    {
      "index": 302,
      "arabic": "اَللّٰھُمَّ وَ نَحْنُ عَبِیْدُكَ التَّاۤئِقُوْنَ اِلٰی وَلِیِّكَ",
      "translation": ""
    },
    {
      "index": 303,
      "arabic": "الْمُذَكِّرِ بِكَ وَ بِنَبِیِّكَ",
      "translation": ""
    },
    {
      "index": 304,
      "arabic": "خَلَقْتَهٗ لَنَا عِصْمَۃً وَّ مَلَاذًا",
      "translation": ""
    },
    {
      "index": 305,
      "arabic": "وَ اَقَمْتَهٗ لَنَا قِوَامًا وَ مَعَاذًا",
      "translation": ""
    },
    {
      "index": 306,
      "arabic": "وَ جَعَلْتَهٗ لِلْمُؤْمِنِیْنَ مِنَّاۤ اِمَامًا",
      "translation": ""
    },
    {
      "index": 307,
      "arabic": "فَبَلِّغْهُ مِنَّا تَحِیَّۃً وَّ سَلَامًا",
      "translation": ""
    },
    {
      "index": 308,
      "arabic": "وَ زِدْنًا بِذٰلِكَ یَا رَبِّ اِكْرَامًا",
      "translation": ""
    },
    {
      "index": 309,
      "arabic": "وَاجْعَلْ مُسْتَقَرَّهٗ لَنَا مُسْتَقَرًّا وَ مُقَامًا",
      "translation": ""
    },
    {
      "index": 310,
      "arabic": "وَ اَتْمِمْ نِعْمَتَكَ بِتَقْدِیْمِكَ اِیَّاهُ اَمَامَنَا",
      "translation": ""
    },
    {
      "index": 311,
      "arabic": "حَتّٰی تُوْرِدَنَا جِنَانَكَ",
      "translation": ""
    },
    {
      "index": 312,
      "arabic": "وَ مُرَافَقَۃَ الشُّھَدَاۤءِ مِنْ خُلَصَاۤئِكَ",
      "translation": ""
    },
    {
      "index": 313,
      "arabic": "اَللّٰھُمَّ صَلِّ عَلٰی مُحَمَّدٍ وَّ اٰلِ مُحَمَّدٍ",
      "translation": ""
    },
    {
      "index": 314,
      "arabic": "وَصَلِّ عَلٰی مَحَمَّدٍ جَدِّهٖ وَ رَسُوْلِكَ",
      "translation": ""
    },
    {
      "index": 315,
      "arabic": "السَّیِّدِ الْاَكْبَرِ",
      "translation": ""
    },
    {
      "index": 316,
      "arabic": "وَعَلٰیۤ اَبِیْهِ السَّیِّدِ الْاَصْغَرِ",
      "translation": ""
    },
    {
      "index": 317,
      "arabic": "وَ جَدَّتِهِ الصِّدِّیْقَۃِ الْكُبْرٰی",
      "translation": ""
    },
    {
      "index": 318,
      "arabic": "فَاطِمِۃَ بِنْتِ مُحَمَّدٍ",
      "translation": ""
    },
    {
      "index": 319,
      "arabic": "صَلَّی اﷲُ عَلَیْهِ وَ اۤلِهٖ",
      "translation": ""
    },
    {
      "index": 320,
      "arabic": "وَ عَلٰی مَنِ اصْطَفَیْتَ مِنْ اٰبَاۤئِهِ الْبَرَرَۃِ",
      "translation": ""
    },
    {
      "index": 321,
      "arabic": "وَ عَلَیْهِ اَفْضَلَ وَ اَكْمَلَ",
      "translation": ""
    },
    {
      "index": 322,
      "arabic": "وَ اَتَمَّ وَ اَدْوَمَ",
      "translation": ""
    },
    {
      "index": 323,
      "arabic": "وَ اَكْثَرَ وَ اَوْفَرَ",
      "translation": ""
    },
    {
      "index": 324,
      "arabic": "مَا صَلَّیْتَ عَلٰیۤ اَحَدٍ مِّنْ اَصْفِیَاۤئِكَ",
      "translation": ""
    },
    {
      "index": 325,
      "arabic": "وَ خِیَرَتِكَ مِنْ خَلْقِكَ",
      "translation": ""
    },
    {
      "index": 326,
      "arabic": "وَ صَلِّ عَلَیْهِ صَلٰوۃً لَا غَایَۃَ لِعَدَدِھَا",
      "translation": ""
    },
    {
      "index": 327,
      "arabic": "وَلَا نِھَایَۃَ لِمَدَدِھَا",
      "translation": ""
    },
    {
      "index": 328,
      "arabic": "وَ لَا نَفَادَ لِاَمَدِھَا",
      "translation": ""
    },
    {
      "index": 329,
      "arabic": "اَللّٰھُمَّ وَ اَقِمْ بِهِ الْحَقَّ",
      "translation": ""
    },
    {
      "index": 330,
      "arabic": "وَ اَدْحِضْ بِهِ الْبَاطِلَ",
      "translation": ""
    },
    {
      "index": 331,
      "arabic": "وَ اَدِلْ بِهٖ اَوْلِیَاۤئَكَ",
      "translation": ""
    },
    {
      "index": 332,
      "arabic": "وَ اَذْلِلْ بِهٖ اَعْدَاۤئَكَ",
      "translation": ""
    },
    {
      "index": 333,
      "arabic": "وَ صِلِ اللّٰھُمَّ بَیْنَنَا وَ بَیْنَهٗ",
      "translation": ""
    },
    {
      "index": 334,
      "arabic": "وُصْلَۃً تُؤَدِّیۤ اِلٰی مُرَافَقَتِ سَلَفِهٖ",
      "translation": ""
    },
    {
      "index": 335,
      "arabic": "وَاجْعَلْنَا مِمَّنْ یَاْخُذُ بِحُجْزَتِھِمْ",
      "translation": ""
    },
    {
      "index": 336,
      "arabic": "وَ یَمْكُثُ فِیْ ظِلِّھِمْ",
      "translation": ""
    },
    {
      "index": 337,
      "arabic": "وَ اَعِنَّا عَلٰی تَاْدِیَۃِ حُقُوْقِهٖۤ اِلَیْهِ",
      "translation": ""
    },
    {
      "index": 338,
      "arabic": "وَالْاِجْتِھَادِ فِیْ طَاعَتِهٖ",
      "translation": ""
    },
    {
      "index": 339,
      "arabic": "وَاجْتِنَابِ مَعْصِیَتِهٖ",
      "translation": ""
    },
    {
      "index": 340,
      "arabic": "وَامْنُنْ عَلَیْنَا بِرِضَاهُ",
      "translation": ""
    },
    {
      "index": 341,
      "arabic": "وَ ھَبْ لَنَا رَاْفَتَهٗ وَ رَحْمَتَهٗ",
      "translation": ""
    },
    {
      "index": 342,
      "arabic": "وَ دُعَاۤئَهٗ وَ خَیْرَهٗ",
      "translation": ""
    },
    {
      "index": 343,
      "arabic": "مَا نَنَالُ بِهٖ سَعَۃً مِّنْ رَحْمَتِكَ",
      "translation": ""
    },
    {
      "index": 344,
      "arabic": "وَ فَوْزًا عِنْدَكَ",
      "translation": ""
    },
    {
      "index": 345,
      "arabic": "وَاجْعَلْ صَلٰوتَنَا بِهٖ مَقْبُوْلَۃً",
      "translation": ""
    },
    {
      "index": 346,
      "arabic": "وَ ذُنُوْبَنَا بِهٖ مَغْفُوْرَۃً",
      "translation": ""
    },
    {
      "index": 347,
      "arabic": "وَ دُعَاۤئَنَا بِہٖ مُسْتَجَابًا",
      "translation": ""
    },
    {
      "index": 348,
      "arabic": "وَاجْعَلْ اَرْزَاقَنَا بِهٖ مَبْسُوْطَۃً",
      "translation": ""
    },
    {
      "index": 349,
      "arabic": "وَ ھُمُوْمَنَا بِهٖ مَكْفِیَّۃً",
      "translation": ""
    },
    {
      "index": 350,
      "arabic": "وَ حَوَاۤئِجَنَا بِهٖ مَقْضِیَّۃً",
      "translation": ""
    },
    {
      "index": 351,
      "arabic": "وَ اَقْبِلْ اِلَیْنَا بِوَجْھِكَ الْكَرِیْمِ",
      "translation": ""
    },
    {
      "index": 352,
      "arabic": "وَاقْبَلْ تَقَرُّبَنَا اِلَیْكَ",
      "translation": ""
    },
    {
      "index": 353,
      "arabic": "وَانْظُرْ اِلَیْنَا نَظْرَۃً رَحِیْمَۃً",
      "translation": ""
    },
    {
      "index": 354,
      "arabic": "نَسْتَكْمِلُ بِھَا الْكَرَامَۃِ عِنْدَكَ",
      "translation": ""
    },
    {
      "index": 355,
      "arabic": "ثُمَّ لَا تَصْرِفْھَا عَنَّا بِجُوْدِكَ",
      "translation": ""
    },
    {
      "index": 356,
      "arabic": "وَاسْقِنَا مِنْ حَوْضِ جَدِّهٖ",
      "translation": ""
    },
    {
      "index": 357,
      "arabic": "صَلَّی اﷲُ عَلَیْهِ وَ اۤلِهٖ",
      "translation": ""
    },
    {
      "index": 358,
      "arabic": "بِكَاْسِهٖ وَ بِیَدِهٖ",
      "translation": ""
    },
    {
      "index": 359,
      "arabic": "رَیًّا رَوِیًّا",
      "translation": ""
    },
    {
      "index": 360,
      "arabic": "ھَنِیْۤئًا سَاۤئِغًا",
      "translation": ""
    },
    {
      "index": 361,
      "arabic": "لَا ظَمَأَ بَعْدَهٗ",
      "translation": ""
    },
    {
      "index": 362,
      "arabic": "یَاۤ اَرْحَمَ الرَّاحِمِیْنَ۔",
      "translation": ""
    }
  ],
  "sourceUrl": "https://www.ya-mahdi.net/view.php?cat=maf_ziy126a&lang=en"
}