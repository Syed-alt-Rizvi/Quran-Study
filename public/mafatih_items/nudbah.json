      "translation": ""
    },
    {
      "index": 36,
      "arabic": "وَ كُلٌّ شَرَعْتَ لَهٗ شَرِیْعَۃً",
      "translation": ""
    },
    {
      "index": 37,
      "arabic": "وَ نَھَجْتَ لَهٗ مِنْھَاجًا",
      "translation": ""
    },
    {
      "index": 38,
      "arabic": "وَ تَخَیَّرْتَ لَهٗ اَوْصِیَاۤءَ",
