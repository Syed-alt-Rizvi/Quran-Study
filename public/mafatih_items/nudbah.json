      "translation": ""
    },
    {
      "index": 42,
      "arabic": "وَ حُجَّۃً عَلٰی عِبَادِكَ",
      "translation": ""
    },
    {
      "index": 43,
      "arabic": "وَ لِئَلَّا یَزُوْلَ الْحَقُّ عَنْ مَقَرِّهٖ",
