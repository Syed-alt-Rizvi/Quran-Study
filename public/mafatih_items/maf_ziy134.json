      "arabic": "يَاۤ اَبَا مُحَمَّدٍ ۟اِلْحَسَنَ الزَّكِيَّ",
      "translation": ""
    },
    {
      "index": 25,
      "arabic": "اَلسَّلَامُ عَلَيْكَ يَا مَوْلَايَ",
      "translation": ""
    },
    {
