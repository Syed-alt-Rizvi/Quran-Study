  "verses": [
    {
      "index": 1,
      "arabic": "اَللّٰهُمَّ حَبِّبْ اِلَيَّ فِيْهِ الْاِحْسَانَ،",
      "translation": "O Allah, on this day, (please) make lovable good-doing for me,"
    },
    {
      "index": 2,
      "arabic": "وَكَرِّهْ اِلَيَّ فِيْهِ الْفُسُوْقَ وَالْعِصْيَانَ،",
      "translation": "make abhorrent for me wickedness and disobedience on this day,"
    },
    {
      "index": 3,
      "arabic": "وَحَرِّمْ عَلَيَّ فِيْهِ السَّخَطَ وَالنِّيْرَانَ",
      "translation": "and prevent me on this day from exposing myself to wrath and the Fire,"
    },
    {
      "index": 4,
      "arabic": "بِعَوْنِكَ يَا غِيَاثَ الْمُسْتَغِيْثِيْنَ۔",
      "translation": "in the name of Your help, O Aide of the seekers of aid!"
    }
  ],
  "sourceUrl": "https://www.ya-mahdi.net/view.php?cat=11_short&lang=en"
