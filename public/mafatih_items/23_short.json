  "verses": [
    {
      "index": 1,
      "arabic": "اَللّٰهُمَّ اغْسِلْنِيْ فِيْهِ مِنَ الذُّنُوْبِ،",
      "translation": "O Allah, on this day, (please) cleanse me from sinning,"
    },
    {
      "index": 2,
      "arabic": "وَطَهِّرْنِيْ فِيْهِ مِنَ الْعُيُوْبِ،",
      "translation": "purify me from defects,"
    },
    {
      "index": 3,
      "arabic": "وَامْتَحِنْ قَلْبِيْ فِيْهِ بِتَقْوَى الْقُلُوْبِ،",
      "translation": "and try my heart with the cordial piety."
    },
    {
      "index": 4,
      "arabic": "يَا مُقِيْلَ عَثَرَاتِ الْمُذْنِبِيْنَ۔",
      "translation": "O He Who overlooks the slips of the guilty ones!"
    }
  ],
