      "translation": ""
    },
    {
      "index": 13,
      "arabic": "وَ اَلْزَمَ اَعْدَاۤئَكَ الْحُجَّۃَ،",
      "translation": ""
    },
    {
      "index": 14,
      "arabic": "مَعَ مَا لَكَ مِنَ الْحُجَجِ الْبَالِغَۃِ عَلٰی جَمِیْعِ خَلْقِهٖ.",
      "translation": ""
    },
    {
      "index": 15,
      "arabic": "اَللّٰهُمَّ فَاجْعَلْ نَفْسِیْ مُطْمَئِنَّۃً بِقَدَرِكَ،",
      "translation": ""
    },
    {
