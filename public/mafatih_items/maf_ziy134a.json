    },
    {
      "index": 46,
      "arabic": "وَ جَوَاۤئِزَ السَّاۤئِلِیْنَ عِنْدَكَ مُوَفَّرَۃٌ،",
      "translation": ""
    },
    {
      "index": 47,
      "arabic": "وَ عَوَاۤئِدَ الْمَزِیْدِ مُتَوَاْتِرَۃٌ،",
      "translation": ""
    },
    {
