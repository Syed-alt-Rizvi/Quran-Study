  "audioUrl": null,
  "introduction": "3RD ZIYARAT OF IMAM E ASR (A.T.F.S.) (HAQQ AL JADEED)\n\nThe following form of ziyarah has been reported by Sayyid Ibn Tawus:\n\nYou may then offer the twelve-unit prayer of ziyarah, separating between each two units with a Taslim statement (i.e. the last part of prayers). You may then utter the (famous) Tasbih al-Zahra’ litany and provide all that as present to the Imam. Upon accomplishment, you may say the following supplicatory prayer:",
  "versesCount": 89,
  "verses": [
    {
      "index": 1,
      "arabic": "اَلسَّلَامُ عَلَى الْحَقِّ الْجَدِيْدِ،",
      "translation": ""
    },
    {
      "index": 2,
      "arabic": "وَ الْعَالِمِ الَّذِيْ عِلْمُهُ لَا يَبِيْدُ.",
      "translation": ""
    },
    {
      "index": 3,
      "arabic": "اَلسَّلَامُ عَلٰى مُحْيِيْ الْمُؤْمِنِيْنَ،",
      "translation": ""
    },
    {
      "index": 4,
      "arabic": "وَ مُبِيْرِ الْكَافِرِيْنَ.",
      "translation": ""
    },
    {
      "index": 5,
      "arabic": "اَلسَّلَامُ عَلٰى مَهْدِيِّ الْاُمَمِ،",
      "translation": ""
    },
    {
      "index": 6,
      "arabic": "وَ جَامِعِ الْكَلِمِ.",
      "translation": ""
    },
    {
      "index": 7,
      "arabic": "اَلسَّلَامُ عَلٰى خَلَفِ السَّلَفِ،",
      "translation": ""
    },
    {
      "index": 8,
      "arabic": "وَ صَاحِبِ الشَّرَفِ.",
      "translation": ""
    },
    {
      "index": 9,
      "arabic": "اَلسَّلَامُ عَلٰى حُجَّةِ الْمَعْبُوْدٍ،",
      "translation": ""
    },
    {
      "index": 10,
      "arabic": "وَ كَلِمَةِ الْمَحْمُودِ.",
      "translation": ""
    },
    {
      "index": 11,
      "arabic": "اَلسَّلَامُ عَلٰى مُعِزِّ الْاَوْلِيَاۤءِ",
      "translation": ""
    },
    {
      "index": 12,
      "arabic": "وَ مُذِلِّ الْاَعْدَاۤءِ.",
      "translation": ""
    },
    {
      "index": 13,
      "arabic": "اَلسَّلَامُ عَلٰى وَارِثِ الْاَنْبِيَاۤءِ",
      "translation": ""
    },
    {
      "index": 14,
      "arabic": "وَ خَاتِمِ الْاَوْصِيَاۤءِ.",
      "translation": ""
    },
    {
      "index": 15,
      "arabic": "اَلسَّلَامُ عَلَى الْقَاۤئِمِ الْمُنْتَظَرِ،",
      "translation": ""
    },
    {
      "index": 16,
      "arabic": "وَ الْعَدْلِ الْمُشْتَهَرِ.",
      "translation": ""
    },
    {
      "index": 17,
      "arabic": "اَلسَّلَامُ عَلَى السَّيْفِ الشَّاهِرِ،",
      "translation": ""
    },
    {
      "index": 18,
      "arabic": "وَ الْقَمَرِ الزَّاهِرِ،",
      "translation": ""
    },
    {
      "index": 19,
      "arabic": "وَ النُّوْرِ الْبَاهِرِ.",
      "translation": ""
    },
    {
      "index": 20,
      "arabic": "اَلسَّلَامُ عَلٰى شَمْسِ الظَّلَامِ،",
      "translation": ""
    },
    {
      "index": 21,
      "arabic": "وَ بَدْرِ التَّمَامِ.",
      "translation": ""
    },
    {
      "index": 22,
      "arabic": "اَلسَّلَامُ عَلٰى رَبِيْعِ الْاَنَامِ،",
      "translation": ""
    },
    {
      "index": 23,
      "arabic": "وَ نَضْرَةِ الْاَيَّامِ.",
      "translation": ""
    },
    {
      "index": 24,
      "arabic": "اَلسَّلَامُ عَلٰى صَاحِبِ الصَّمْصَامِ،",
      "translation": ""
    },
    {
      "index": 25,
      "arabic": "وَ فَلَّاقِ الْهَامِ.",
      "translation": ""
    },
    {
      "index": 26,
      "arabic": "اَلسَّلَامُ عَلَى الدِّيْنِ الْمَأْثُوْرِ،",
      "translation": ""
    },
    {
      "index": 27,
      "arabic": "وَ الْكِتَابِ الْمَسْطُوْرِ.",
      "translation": ""
    },
    {
      "index": 28,
      "arabic": "اَلسَّلَامُ عَلٰى بَقِيَّةِ اللّٰهِ فِيْ بِلَادِهِ،",
      "translation": ""
    },
    {
      "index": 29,
      "arabic": "وَ حُجَّتِهِ عَلٰى عِبَادِهِ،",
      "translation": ""
    },
    {
      "index": 30,
      "arabic": "اَلْمُنْتَهٰيۤ اِلَيْهِ مَوَارِيْثُ الْاَنْبِيَاۤءِ،",
      "translation": ""
    },
    {
      "index": 31,
      "arabic": "وَ لَدَيْهِ مَوْجُوْدٌ اٰثَارُ الْاَصْفِيَاۤءِ.",
      "translation": ""
    },
    {
      "index": 32,
      "arabic": "اَلسَّلَامُ عَلَى الْمُؤْتَمَنِ عَلَى السِّرِّ،",
      "translation": ""
    },
    {
      "index": 33,
      "arabic": "وَ الْوَلِيِّ لِلْاَمْرِ.",
      "translation": ""
    },
    {
      "index": 34,
      "arabic": "اَلسَّلَامُ عَلَى الْمَهْدِيِّ،",
      "translation": ""
    },
    {
      "index": 35,
      "arabic": "الَّذِيْ وَعَدَ اللّٰهُ عَزَّ وَ جَلَّ بِهِ الْاُمَمَ،",
      "translation": ""
    },
    {
      "index": 36,
      "arabic": "اَنْ يَجْمَعَ بِهِ الْكَلِمَ،",
      "translation": ""
    },
    {
      "index": 37,
      "arabic": "وَ يَلُمَّ بِهِ الشَّعَثَ،",
      "translation": ""
    },
    {
      "index": 38,
      "arabic": "وَ يَمْلَاَ بِهِ الْاَرْضَ قِسْطًا وَ عَدْلًا،",
      "translation": ""
    },
    {
      "index": 39,
      "arabic": "وَ يُمَكِّنَ لَهُ،",
      "translation": ""
    },
    {
      "index": 40,
      "arabic": "وَ يُنْجِزَ بِهِ وَعْدَ الْمُؤْمِنِيْنَ.",
      "translation": ""
    },
    {
      "index": 41,
      "arabic": "اَشْهَدُ يَا مَوْلَايَ،",
      "translation": ""
    },
    {
      "index": 42,
      "arabic": "اَنَّكَ وَ الْاَئِمَّةَ مِنْ اٰبَاۤئِكَ",
      "translation": ""
    },
    {
      "index": 43,
      "arabic": "اَئِمَّتِيْ وَ مَوَالِيَّ",
      "translation": ""
    },
    {
      "index": 44,
      "arabic": "فِي الْحَيَاةِ الدُّنْيَا، وَ يَوْمَ يَقُوْمُ الْاَشْهَادُ.",
      "translation": ""
    },
    {
      "index": 45,
      "arabic": "اَسْاَلُكَ يَا مَوْلَايَ،",
      "translation": ""
    },
    {
      "index": 46,
      "arabic": "اَنْ تَسْاَلَ اللّٰهَ تَبَارَكَ وَ تَعَالٰى،",
      "translation": ""
    },
    {
      "index": 47,
      "arabic": "فِيْ صَلَاحِ شَأْنِيْ،",
      "translation": ""
    },
    {
      "index": 48,
      "arabic": "وَ قَضَاۤءِ حَوَاۤئِجِيْ،",
      "translation": ""
    },
    {
      "index": 49,
      "arabic": "وَ غُفْرَانِ ذُنُوْبِيْ،",
      "translation": ""
    },
    {
      "index": 50,
      "arabic": "وَ الْاَخْذِ بِيَدِيْ،",
      "translation": ""
    },
    {
      "index": 51,
      "arabic": "فِيْ دِيْنِيْ وَ دُنْيَايَ وَ اٰخِرَتِيْ،",
      "translation": ""
    },
    {
      "index": 52,
      "arabic": "لِيْ وَ لِاِخْوَانِيْ وَ اَخَوَاتِيَ الْمُؤْمِنِيْنَ وَ الْمُؤْمِنَاتِ كَآفَّةً،",
      "translation": ""
    },
    {
      "index": 53,
      "arabic": "اِنَّهُ غَفُوْرٌ رَحِيْمٌ۔",
      "translation": ""
    },
    {
      "index": 54,
      "arabic": "اللّٰهُمَّ صَلِّ عَلٰى حُجَّتِكَ فِيۤ اَرْضِكَ،",
      "translation": ""
    },
    {
      "index": 55,
      "arabic": "وَ خَلِيْفَتِكَ فِيْ بِلَادِكَ،",
      "translation": ""
    },
    {
      "index": 56,
      "arabic": "الدَّاعِيۤ اِلٰى سَبِيْلِكَ،",
      "translation": ""
    },
    {
      "index": 57,
      "arabic": "وَ الْقَاۤئِمِ بِقِسْطِكَ،",
      "translation": ""
    },
    {
      "index": 58,
      "arabic": "وَ الْفَاۤئِزِ بِاَمْرِكَ،",
      "translation": ""
    },
    {
      "index": 59,
      "arabic": "وَلِيِّ الْمُؤْمِنِينَ",
      "translation": ""
    },
    {
      "index": 60,
      "arabic": "وَ مُبِيْرِ الْكَافِرِيْنَ،",
      "translation": ""
    },
    {
      "index": 61,
      "arabic": "وَ مُجَلِّي الظُّلْمَةِ",
      "translation": ""
    },
    {
      "index": 62,
      "arabic": "وَ مُنِيْرِ الْحَقِّ،‏",
      "translation": ""
    },
    {
      "index": 63,
      "arabic": "وَ الصَّادِعِ بِالْحِكْمَةِ",
      "translation": ""
    },
    {
      "index": 64,
      "arabic": "وَ الْمَوْعِظَةِ الْحَسَنَةِ وَ الصِّدْقِ،",
      "translation": ""
    },
    {
      "index": 65,
      "arabic": "وَ كَلِمَتِكَ وَ عَيْبَتِكَ",
      "translation": ""
    },
    {
      "index": 66,
      "arabic": "وَ عَيْنِكَ فِيۤ اَرْضِكَ،",
      "translation": ""
    },
    {
      "index": 67,
      "arabic": "الْمُتَرَقِّبِ الْخَاۤئِفِ،",
      "translation": ""
    },
    {
      "index": 68,
      "arabic": "الْوَلِيِّ النَّاصِحِ،",
      "translation": ""
    },
    {
      "index": 69,
      "arabic": "سَفِيْنَةِ النَّجَاةِ،",
      "translation": ""
    },
    {
      "index": 70,
      "arabic": "وَ عَلَمِ الْهُدٰى،",
      "translation": ""
    },
    {
      "index": 71,
      "arabic": "وَ نُوْرِ اَبْصَارِ الْوَرٰى،",
      "translation": ""
    },
    {
      "index": 72,
      "arabic": "وَ خَيْرِ مَنْ تَقَمَّصَ وَ ارْتَدٰى،",
      "translation": ""
    },
    {
      "index": 73,
      "arabic": "وَ الْوِتْرِ الْمَوْتُوْرِ،",
      "translation": ""
    },
    {
      "index": 74,
      "arabic": "وَ مُفَرِّجِ الْكَرْبِ،",
      "translation": ""
    },
    {
      "index": 75,
      "arabic": "وَ مُزِيْلِ الْهَمِّ،",
      "translation": ""
    },
    {
      "index": 76,
      "arabic": "وَ كَاشِفِ الْبَلْوٰى،",
      "translation": ""
    },
    {
      "index": 77,
      "arabic": "صَلَوَاتُ اللّٰهِ عَلَيْهِ",
      "translation": ""
    },
    {
      "index": 78,
      "arabic": "وَ عَلٰى اٰبَاۤئِهِ، الْاَئِمَّةِ الْهَادِيْنَ،",
      "translation": ""
    },
    {
      "index": 79,
      "arabic": "وَ الْقَادَةِ الْمَيَامِيْنِ،",
      "translation": ""
    },
    {
      "index": 80,
      "arabic": "مَا طَلَعَتْ كَوَاكِبُ الْاَسْحَارِ،",
      "translation": ""
    },
    {
      "index": 81,
      "arabic": "وَ اَوْرَقَتِ الْاَشْجَارُ،",
      "translation": ""
    },
    {
      "index": 82,
      "arabic": "وَ اَيْنَعَتِ الْاَثْمَارُ،",
      "translation": ""
    },
    {
      "index": 83,
      "arabic": "وَ اخْتَلَفَ اللَّيْلُ وَ النَّهَارُ،",
      "translation": ""
    },
    {
      "index": 84,
      "arabic": "وَ غَرَّدَتِ الْاَطْيَارُ.",
      "translation": ""
    },
    {
      "index": 85,
      "arabic": "اَللّٰهُمَّ انْفَعْنَا بِحُبِّهِ،",
      "translation": ""
    },
    {
      "index": 86,
      "arabic": "وَ احْشُرْنَا فِيْ زُمْرَتِهِ،",
      "translation": ""
    },
    {
      "index": 87,
      "arabic": "وَ تَحْتَ لِوَاۤئِهِ،",
      "translation": ""
    },
    {
      "index": 88,
      "arabic": "اِلٰهَ الْحَقِّ، اٰمِيْنَ",
      "translation": ""
    },
    {
      "index": 89,
      "arabic": "رَبَّ الْعَالَمِيْنَ۔",
      "translation": ""
    }
  ],
  "sourceUrl": "https://www.ya-mahdi.net/view.php?cat=maf_ziy124c&lang=en"
}