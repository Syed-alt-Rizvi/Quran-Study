rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isGuest() {
      return true; // We use local device IDs and client verification
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidDiscussion(data) {
      return data.content is string && data.content.size() > 0 && data.content.size() <= 10000 &&
             data.author is string && data.author.size() > 0 && data.author.size() <= 150 &&
             data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128;
    }

    match /discussions/{discussionId} {
      allow read, list: if true; // Public read & real-time snapshot sync across all devices
      allow create: if isValidDiscussion(incoming());
      allow update: if true;
      allow delete: if true;
    }

    // App users telemetry & location
    match /app_users/{userId} {
      allow read: if true;
      allow create, update: if isValidId(userId);
      allow delete: if true;
    }

    // App metrics & download counters
    match /app_stats/{statId} {
      allow read: if true;
      allow write: if true;
    }

    // Reports collection
    match /reports/{reportId} {
      allow read: if true;
      allow create: if true;
      allow delete: if true;
    }

    // User data transfer & sync profiles for cross-site forwarding & multi-device sync
    match /user_sync_profiles/{syncId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }
  }
}
