{
  "entities": {
    "Discussion": {
      "title": "Discussion",
      "description": "A user-submitted discussion or comment on an Ayah.",
      "type": "object",
      "properties": {
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 5000
        },
        "author": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "maxLength": 255
        },
        "userId": {
          "type": "string",
          "maxLength": 128
        },
        "createdAt": {
          "type": "timestamp"
        },
        "replyToId": {
          "type": "string",
          "maxLength": 128
        },
        "ayahRef": {
          "type": "object",
          "properties": {
            "surahNumber": {
              "type": "number"
            },
            "ayahNumber": {
              "type": "number"
            },
            "surahName": {
              "type": "string",
              "maxLength": 100
            }
          }
        },
        "isModerated": {
          "type": "boolean"
        }
      },
      "required": ["content", "author", "userId", "createdAt"]
    }
  },
  "firestore": {
    "discussions/{discussionId}": {
      "schema": {
        "$ref": "#/entities/Discussion"
      },
      "description": "Global and Ayah-specific discussions."
    }
  }
}
