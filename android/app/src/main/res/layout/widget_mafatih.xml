<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_mafatih_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg_mafatih"
    android:padding="12dp">

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📖 مفاتیح الجنان و دعائیں"
            android:textColor="@color/widget_blue"
            android:textSize="12sp"
            android:textStyle="bold"
            android:ellipsize="end"
            android:singleLine="true" />

        <TextView
            android:id="@+id/widget_mafatih_day_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="شبِ جمعہ / پنجشنبہ"
            android:textColor="@color/widget_gold_light"
            android:textSize="10sp"
            android:textStyle="bold"
            android:background="@drawable/widget_tag_gold"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:singleLine="true" />
    </LinearLayout>

    <!-- Center Card: Featured Dua & Excerpt -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@drawable/widget_card_rounded"
        android:padding="8dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/widget_mafatih_dua_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="دعائے کمیل • زیارتِ امام حسین (ع)"
                android:textColor="@color/widget_gold_light"
                android:textSize="13sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_mafatih_category"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="اعمالِ شبِ جمعہ"
                android:textColor="@color/widget_emerald_light"
                android:textSize="10sp"
                android:singleLine="true"
                android:layout_marginLeft="4dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_mafatih_arabic_excerpt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="اللَّهُمَّ إِنِّي أَسْأَلُكَ بِرَحْمَتِكَ الَّتِي وَسِعَتْ كُلَّ شَيْءٍ"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:gravity="right"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_mafatih_urdu_translation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="اے اللہ! میں تیری اس رحمت کے طفیل سوال کرتا ہوں جو ہر چیز پر محیط ہے"
            android:textColor="@color/widget_text_muted"
            android:textSize="10sp"
            android:singleLine="true"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Bottom Footer Row: Ma'soom Badge & Open Mafatih Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_mafatih_masoom_tag"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="زیارتِ مخصوص: امام حسین (ع)"
            android:textColor="@color/widget_blue"
            android:textSize="11sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end"
            android:layout_marginRight="8dp" />

        <TextView
            android:id="@+id/widget_btn_open_mafatih"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="تلاوت و زیارت ➔"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold"
            android:background="@drawable/widget_button_rounded"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp" />
    </LinearLayout>

</LinearLayout>
