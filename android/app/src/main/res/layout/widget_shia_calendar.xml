<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_calendar_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg_rounded"
    android:padding="14dp">

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🌙 Shia Islamic Calendar"
            android:textColor="@color/widget_gold"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_calendar_gregorian"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Today"
            android:textColor="@color/widget_text_muted"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Hijri Date Display -->
    <TextView
        android:id="@+id/widget_calendar_hijri"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="۱۴ ربیع الثانی ۱۴۴۸ ھ"
        android:textColor="@color/widget_emerald"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="4dp" />

    <!-- Shia Occasion of the Day -->
    <TextView
        android:id="@+id/widget_calendar_occasion"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text="Shia Islamic Holy Day &amp; Recommended Ziyaraat"
        android:textColor="@color/widget_text_white"
        android:textSize="12sp"
        android:gravity="center"
        android:ellipsize="end"
        android:maxLines="2" />

    <!-- Bottom Button to Open Full Calendar -->
    <Button
        android:id="@+id/widget_btn_open_calendar"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:text="View Full Shia Calendar"
        android:textColor="@color/widget_text_white"
        android:textSize="11sp"
        android:background="@drawable/widget_button_rounded"
        android:layout_marginTop="6dp" />
</LinearLayout>
