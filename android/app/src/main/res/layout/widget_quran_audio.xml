<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_audio_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg_rounded"
    android:padding="14dp">

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🔊 Holy Quran Audio"
            android:textColor="@color/widget_gold"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_audio_reciter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mishary Alafasy"
            android:textColor="@color/widget_emerald"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Surah Title & Arabic Calligraphy -->
    <TextView
        android:id="@+id/widget_audio_arabic_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="سورة الفاتحة"
        android:textColor="@color/widget_text_white"
        android:textSize="18sp"
        android:gravity="center"
        android:layout_marginTop="6dp" />

    <TextView
        android:id="@+id/widget_audio_surah_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Surah 1: Al-Fatiha • 7 Ayahs"
        android:textColor="@color/widget_text_muted"
        android:textSize="11sp"
        android:gravity="center"
        android:layout_marginBottom="8dp" />

    <!-- Playback Controls Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="2dp"
        android:weightSum="3">

        <!-- Previous Surah Button -->
        <Button
            android:id="@+id/widget_audio_btn_prev"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:text="⏮ Prev"
            android:textColor="@color/widget_text_white"
            android:textSize="11sp"
            android:background="@drawable/widget_card_rounded"
            android:layout_marginEnd="4dp" />

        <!-- Play / Pause Action Button -->
        <Button
            android:id="@+id/widget_audio_btn_play"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:text="▶ Listen"
            android:textColor="@color/widget_text_white"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/widget_button_rounded"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp" />

        <!-- Next Surah Button -->
        <Button
            android:id="@+id/widget_audio_btn_next"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:text="Next ⏭"
            android:textColor="@color/widget_text_white"
            android:textSize="11sp"
            android:background="@drawable/widget_card_rounded"
            android:layout_marginStart="4dp" />
    </LinearLayout>
</LinearLayout>
