<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_tafseer_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg_rounded"
    android:padding="14dp">

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📖 Shia Tafseer of the Day"
            android:textColor="@color/widget_gold"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_tafseer_source"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tafseer Namoona"
            android:textColor="@color/widget_emerald"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Ayah Reference Header -->
    <TextView
        android:id="@+id/widget_tafseer_ayah_ref"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Surah Al-Ahzab (33:33)"
        android:textColor="@color/widget_text_muted"
        android:textSize="11sp"
        android:layout_marginTop="4dp" />

    <!-- Quran Arabic Excerpt -->
    <TextView
        android:id="@+id/widget_tafseer_arabic"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="إِنَّمَا يُرِيدُ اللَّهُ لِيُذْهِبَ عَنكُمُ الرِّجْسَ أَهْلَ الْبَيْتِ وَيُطَهِّرَكُمْ تَطْهِيرًا"
        android:textColor="@color/widget_text_white"
        android:textSize="16sp"
        android:gravity="center"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp" />

    <!-- Tafseer Commentary Text -->
    <TextView
        android:id="@+id/widget_tafseer_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text="Ayat al-Tatheer conclusively establishes the divine infallibility and purity of the Ahlulbayt (a.s) from all blemish and imperfection."
        android:textColor="@color/widget_text_muted"
        android:textSize="11sp"
        android:ellipsize="end"
        android:maxLines="3"
        android:lineSpacingExtra="2dp" />

    <!-- Bottom Button to Read in App -->
    <Button
        android:id="@+id/widget_btn_read_tafseer"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:text="Read Full Shia Tafseer"
        android:textColor="@color/widget_text_white"
        android:textSize="11sp"
        android:background="@drawable/widget_button_rounded"
        android:layout_marginTop="6dp" />
</LinearLayout>
